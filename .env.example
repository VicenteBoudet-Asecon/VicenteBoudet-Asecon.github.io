# Clave de acceso de Web3Forms para el formulario de contacto.
# Consíguela gratis en https://web3forms.com/ indicando el correo donde quieres
# recibir los mensajes (por ejemplo info@aseconsa.com) y pégala aquí.
# Copia este archivo como .env (que ya está en .gitignore) antes de editarlo.
PUBLIC_WEB3FORMS_KEY=

# URL real del sitio cuando el build es un preview (la usa .github/workflows/
# deploy-preview.yml). En local y en cualquier build "de verdad" déjala vacía:
# astro.config.mjs cae entonces a https://aseconsa.com.
PREVIEW_SITE_URL=

# 'true' para que /admin (el panel de analítica de demostración, con datos
# falsos) se genere en el build. En cualquier otro valor, o sin definir,
# getStaticPaths() de src/pages/admin/[...slug].astro no genera nada y
# /admin no existe en dist/ — que es la única protección real posible en un
# sitio estático. Úsala solo en local, nunca en el build que se publica.
PUBLIC_ENABLE_ADMIN=

# '1' para ver en preview los canales de contacto que todavía no tienen dato
# real (WhatsApp, agendamiento, guía descargable) en su estado "maqueta":
# visibles y con foco, pero nunca como enlaces reales. Ver src/data/channels.js.
# NUNCA definirla en el build de producción.
PUBLIC_PREVIEW_CHANNELS=

# Site key de Cloudflare Turnstile para el antispam del formulario (ver
# LeadForm.astro). Sin ella, el único filtro antispam es el honeypot.
PUBLIC_TURNSTILE_SITEKEY=

# ID de la propiedad de Google Analytics 4 (formato G-XXXXXXXXXX). Sin ella
# no se carga gtag ni se muestra el banner de consentimiento — no hay nada
# que medir ni de qué pedir consentimiento. NUNCA definirla en el build de
# preview: contaminaría la propiedad real con tráfico de prueba. Ver
# src/components/Analytics.astro y src/components/ConsentBanner.astro.
PUBLIC_GA4_ID=

# Meta tag de verificación de Google Search Console (el valor del atributo
# content, no la etiqueta completa). La vía preferida es un registro TXT en
# el DNS (sobrevive a cambios de hosting); esta variable es el respaldo.
PUBLIC_GSC_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────
# Lo que NO se configura en este archivo
#
# Estas seis variables de arriba son las del build de Astro: las lee
# `import.meta.env` y Astro las carga desde `.env`. El proyecto usa además
# otras que viven en otra parte, y ponerlas acá no haría nada:
#
#   SMOKE_FORM_LIVE, SMOKE_ADMIN_ENABLED, SMOKE_LEGAL_INDEXABLE
#     → las lee scripts/smoke.mjs con process.env, no desde .env. Se pasan
#       en la línea de comando:  SMOKE_FORM_LIVE=1 npm run smoke -- <url>
#
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
#     → secrets del entorno `production` en GitHub (Settings → Environments).
#   CLOUDFLARE_PAGES_PROJECT
#     → variable del mismo entorno, con el nombre real del proyecto de Pages.
#
#   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET
#     → variables de entorno del proyecto de Cloudflare Pages (cifradas),
#       que leen functions/api/auth.js y callback.js. Nunca en el repo.
#
# La tabla completa —qué enciende cada una y cómo se verifica— está en el
# README, sección "Runbook de activación".
# ─────────────────────────────────────────────────────────────────────────
