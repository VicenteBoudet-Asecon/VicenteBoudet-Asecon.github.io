---
// Equipo en la home, con el formato de la referencia (vinsonconsulting.cl,
// "Nuestro equipo es nuestro mayor activo"): sección oscura, texto a un lado y
// un mosaico de retratos al otro. En la referencia cada tarjeta lleva una cita
// del consultor; acá NO hay citas del equipo (no se inventan), así que cada
// tarjeta lleva nombre y cargo, que ya están publicados en /equipo.
//
// Quiénes aparecen: dirección y gerencia confirmadas por el organigrama de
// 2026-11-27 (no está Jeanette Lewitt: su cargo sigue PENDIENTE en content.js).
// Para cambiar el mosaico basta con editar esta lista de `id` de `team`.
import { getContent, team } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.teamStrip.title;

const visibles = [
  'rafael-cohn',
  'thomas-taub',
  'fernanda-yoma',
  'marco-del-rio',
  'hector-rodriguez',
  'cristian-avila',
];
// Solo quienes tienen foto: nunca una ruta que no existe en public/team/.
const personas = visibles
  .map((id) => team.find((t) => t.id === id))
  .filter((p): p is (typeof team)[number] & { img: string } => Boolean(p && p.img));
---

<section class="on-ink relative isolate overflow-hidden bg-plum-deep text-paper">
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -left-28 -z-10 hidden w-[30rem] -rotate-[10deg] opacity-[0.07] md:block"
  />

  <div class="wrap grid items-center gap-14 py-20 md:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-brass-light">{c.teamStrip.eyebrow}</p>
      <h2 class="mt-4 text-balance font-display text-4xl font-light leading-[1.08] tracking-tight text-white md:text-5xl">
        {before}{' '}<span class="text-brass-light">{accent}</span>{cierre(accent)}
      </h2>
      <p class="mt-6 max-w-[46ch] text-base leading-relaxed text-paper/85 md:text-lg">{c.teamStrip.body}</p>

      <a
        href={path('team', lang)}
        class="mt-9 inline-flex items-center gap-2.5 rounded-full border-2 border-paper/70 px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-paper hover:text-ink"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4.5 3.5h8v8M12.5 3.5l-9 9" />
        </svg>
        {c.ui.meetTheTeam}
      </a>
    </div>

    <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-5">
      {personas.map((p, i) => (
        <li class:list={[i % 3 === 1 && 'sm:mt-10']}>
          <figure class="group relative isolate overflow-hidden bg-ink">
            <img
              src={p.img}
              alt=""
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover grayscale-[0.3] transition duration-500 group-hover:scale-105 group-hover:grayscale-0 motion-reduce:transition-none"
              onerror="this.style.opacity='0'"
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/85 to-transparent px-4 pb-4 pt-12">
              <span class="block font-display text-base leading-tight text-white">{p.name}</span>
              <span class="mt-1 block text-xs leading-snug text-paper/80">{c.roles[p.role]}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
