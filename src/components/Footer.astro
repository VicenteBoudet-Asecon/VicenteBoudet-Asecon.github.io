---
import { company, getContent } from '../data/content';
import { getLangFromUrl, navOrder, path } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper/70">
  <div class="wrap flex flex-col gap-10 py-14 md:flex-row md:items-start md:justify-between">
    <div class="max-w-sm">
      <img
        src="/brand/logo-asecon-blanco.svg"
        alt={company.name}
        width="341"
        height="87"
        class="h-10 w-auto"
      />
      <p class="mt-3 text-sm leading-relaxed">{c.meta.footerBlurb}</p>
      <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-brass-light">
        Registro CMF N&deg; {company.cmfRegistry}
      </p>
    </div>

    <nav class="grid grid-cols-2 gap-x-10 gap-y-1 text-[13.5px] sm:grid-cols-3">
      {navOrder.map((key) => (
        <a href={path(key, lang)} class="py-1 hover:text-brass-light">{c.nav[key]}</a>
      ))}
    </nav>

    <div class="font-mono text-xs">
      <p>{company.phone1}</p>
      <p>{company.phone2}</p>
      <p class="mt-2"><a href={`mailto:${company.email}`} class="hover:text-brass-light">{company.email}</a></p>
      <a href={company.linkedin} target="_blank" rel="noopener" class="mt-2 inline-block hover:text-brass-light">
        LinkedIn &#8599;
      </a>
    </div>
  </div>

  <div class="border-t border-paper/10">
    <div class="wrap py-6 text-xs text-paper/50">
      <p>&copy; {company.name} {year} &mdash; {c.ui.allRightsReserved}</p>
    </div>
  </div>
</footer>
