---
import { company, getContent } from '../data/content';
import { getLangFromUrl, navOrder, legalOrder, path } from '../i18n/config';
import { previewChannels } from '../data/channels';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const year = new Date().getFullYear();
const showConsentLink = Boolean(import.meta.env.PUBLIC_GA4_ID) || previewChannels;
// Mismo formato que ChannelLinks: sin espacios en el href, tal cual en el texto.
const phones = [company.phone1, company.phone2].map((label) => ({ label, href: `tel:${label.replace(/\s/g, '')}` }));
---

<footer class="on-ink bg-ink text-paper/70">
  {/*
    Las tres columnas van en fila recién desde lg, igual que el header. En md
    (768–1023) el bloque de marca se quedaba con casi todo el ancho y la
    rejilla de la nav bajaba a ~130 px: "Novedades" se montaba sobre el correo.
  */}
  <div class="wrap flex flex-col gap-10 py-14 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-sm">
      <img
        src="/brand/logo-asecon-blanco.svg"
        alt={company.name}
        width="341"
        height="87"
        class="h-10 w-auto"
      />
      <p class="mt-3 text-sm leading-relaxed">{c.meta.footerBlurb}</p>
      <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-brass-light">
        Registro CMF N&deg; {company.cmfRegistry}
      </p>
    </div>

    <nav aria-label={c.ui.footerNavLabel} class="grid grid-cols-2 gap-x-10 gap-y-1 text-[13.5px] sm:grid-cols-3">
      {navOrder.map((key) => (
        <a href={path(key, lang)} class="py-1 hover:text-brass-light">{c.nav[key]}</a>
      ))}
    </nav>

    <div class="font-mono text-xs">
      {phones.map((p) => (
        <p><a href={p.href} class="inline-block py-1 hover:text-brass-light">{p.label}</a></p>
      ))}
      <p class="mt-2"><a href={`mailto:${company.email}`} class="hover:text-brass-light">{company.email}</a></p>
      <a href={company.linkedin} target="_blank" rel="noopener" class="mt-2 inline-block hover:text-brass-light">
        LinkedIn &#8599;
      </a>
    </div>
  </div>

  <div class="border-t border-paper/10">
    <div class="wrap flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-paper/70">&copy; {company.name} {year} &mdash; {c.ui.allRightsReserved}</p>
      <nav aria-label={c.ui.legalNavLabel} class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-[11px] uppercase tracking-[0.08em] text-paper/70">
        {legalOrder.map((key) => (
          <a href={path(key, lang)} class="hover:text-brass-light">{c.nav[key]}</a>
        ))}
        {showConsentLink && (
          <button type="button" data-reopen-consent class="hover:text-brass-light">{c.consent.manage}</button>
        )}
      </nav>
    </div>
  </div>
</footer>
