---
// Franja de cierre, deliberadamente discreta: aparece en varias páginas, así
// que no puede pesar como una sección propia. Una línea, los canales
// disponibles y un botón.
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';
import ChannelLinks from './ChannelLinks.astro';

interface Props {
  /** Qué página la muestra, para adaptar la pregunta. */
  variant?: 'home' | 'services' | 'clients' | 'seal' | 'technology' | 'team';
}
const { variant = 'home' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
---

<section class="border-t border-plum/15 bg-paper-dim/40">
  <div class="wrap flex flex-col gap-5 py-10 md:flex-row md:items-center md:justify-between md:py-12">
    <div>
      <p class="font-display text-xl leading-snug text-ink md:text-2xl">
        {c.cta[variant]}
      </p>
      <div class="mt-3 text-ink/60">
        <ChannelLinks show={['call', 'whatsapp', 'email']} context={`cta-banner-${variant}`} />
      </div>
    </div>

    <a
      href={path('contact', lang)}
      data-cta="cta-primary"
      data-cta-location={`cta-banner-${variant}`}
      class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-plum px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-plum-deep md:self-auto"
    >
      {c.cta.action}
    </a>
  </div>
</section>
