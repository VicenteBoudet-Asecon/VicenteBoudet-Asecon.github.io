---
// Franja de cierre, deliberadamente discreta: aparece en varias páginas, así
// que no puede pesar como una sección propia. Una línea, los canales
// disponibles y un botón.
import { company, getContent } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';
import ChannelLinks from './ChannelLinks.astro';

interface Props {
  /** Qué página la muestra, para adaptar la pregunta. */
  variant?: 'home' | 'services' | 'clients' | 'seal' | 'technology' | 'team';
  /**
   * [texto, palabra en cursiva]. Si se pasa, la franja sale en su versión
   * grande (la pregunta como bajada y este titular encima, como el cierre de
   * la referencia vinsonconsulting.cl/servicios). Sin esto, la versión
   * discreta de siempre.
   */
  headline?: [string, string];
}
const { variant = 'home', headline } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
---

{headline ? (
  <section class="bg-paper-dim">
    <div class="wrap flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between md:gap-12 md:py-20">
      <div>
        <p class="font-display text-lg text-ink md:text-xl">{c.cta[variant]}</p>
        <h2 class="mt-2 font-display text-3xl font-light leading-tight text-ink md:text-5xl">
          {headline[0]}{' '}<span class="text-plum">{headline[1]}</span>{cierre(headline[1])}
        </h2>
        <div class="mt-5 text-ink/70">
          <ChannelLinks show={['call', 'whatsapp', 'email']} context={`cta-banner-${variant}`} />
        </div>
        {/* Igual que en la versión discreta: en la página del Sello la
            dirección vive en este bloque, no en el texto del Sello. */}
        {variant === 'seal' && (
          <p class="mt-5 border-l-2 border-brass pl-4 font-mono text-xs leading-relaxed text-ink/70">
            {company.address}
          </p>
        )}
      </div>

      <a
        href={path('contact', lang)}
        data-cta="cta-primary"
        data-cta-location={`cta-banner-${variant}`}
        class="inline-flex shrink-0 items-center gap-2.5 self-start rounded-full bg-plum px-7 py-4 font-mono text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-plum-deep md:self-auto"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4.5 3.5h8v8M12.5 3.5l-9 9" />
        </svg>
        {c.cta.action}
      </a>
    </div>
  </section>
) : (
<section class="border-t border-plum/15 bg-paper-dim/40">
  <div class="wrap flex flex-col gap-5 py-10 md:flex-row md:items-center md:justify-between md:py-12">
    <div>
      <h2 class="font-display text-xl leading-snug text-ink md:text-2xl">
        {c.cta[variant]}
      </h2>
      <div class="mt-3 text-ink/70">
        <ChannelLinks show={['call', 'whatsapp', 'email']} context={`cta-banner-${variant}`} />
      </div>
      {/* En la página del Sello la dirección vive en el bloque de contacto, no
          en el texto del Sello. */}
      {variant === 'seal' && (
        <p class="mt-4 border-l-2 border-brass pl-4 font-mono text-xs leading-relaxed text-ink/70">
          {company.address}
        </p>
      )}
    </div>

    <a
      href={path('contact', lang)}
      data-cta="cta-primary"
      data-cta-location={`cta-banner-${variant}`}
      class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-plum px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-plum-deep md:self-auto"
    >
      {c.cta.action}
    </a>
  </div>
</section>
)}
