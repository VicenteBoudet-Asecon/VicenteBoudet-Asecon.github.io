---
// Página de Equipo con el formato de /equipo de la referencia
// (vinsonconsulting.cl): titular editorial y retratos altos para la Dirección.
// Debajo, el resto de la gente se organiza por ÁREA con un selector: de cada área
// se ven sus jefaturas y su equipo en filas compactas, una área a la vez. Antes
// eran 4 tarjetas altas por fila para toda la gente (casi siete pantallas de
// scroll con el equipo desplegado); así la página es un orden de magnitud más
// corta y sigue mostrando a todos.
//
// De dónde sale cada cosa (ver `team` en content.js):
//  · Dirección: las personas con `area: 'direccion'`.
//  · Cada área: las personas con ese `area`. Una persona es "jefatura" de su área
//    si su jefe está fuera de ella; el resto es el equipo del área.
//
// Lo que NO se copia de la referencia:
//  · el contador "+70 Consultores": la dotación del estudio no está confirmada
//    (company.headcount) y la regla 16 de scripts/validate.mjs impide afirmar
//    una cifra de profesionales (por la misma razón los botones del selector no
//    llevan la cantidad de personas de cada área);
//  · los filtros por categoría y las citas de cada persona: no hay citas del
//    equipo (no se inventan).
//
// Sin JavaScript se ven todas las áreas, una debajo de otra (ver `data-area-panel`
// en el bloque `@media (scripting: none)` de global.css).
import { team, getContent } from '../data/content';
import { getLangFromUrl, cierre } from '../i18n/config';
import TeamCard from './TeamCard.astro';
import TeamRow from './TeamRow.astro';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.teamPage.headline;

const porId = Object.fromEntries(team.map((p) => [p.id, p]));
const direccion = team.filter((p) => p.area === 'direccion');

// Orden de las áreas en el selector. Un área nueva en `team` que no esté acá se
// agrega al final (con su clave como nombre si falta la etiqueta en content.js).
const ORDEN = ['contabilidad', 'impuestos', 'auditoria', 'rrhh', 'administracion', 'laboral', 'ti'];
const ids = [...ORDEN, ...new Set(team.map((p) => p.area).filter((a) => a && a !== 'direccion' && !ORDEN.includes(a)))];

const areas = ids
  .map((id) => {
    const gente = team.filter((p) => p.area === id);
    const esJefatura = (p) => !p.reportsTo || porId[p.reportsTo]?.area !== id;
    return {
      id,
      nombre: c.org.areas[id] ?? id,
      jefaturas: gente.filter(esJefatura),
      equipo: gente.filter((p) => !esJefatura(p)),
    };
  })
  .filter((a) => a.jefaturas.length + a.equipo.length > 0);
---

<section id="equipo" class="bg-white">
  <div class="wrap pb-20 pt-12 md:pb-28 md:pt-16">
    <div class="mb-14 grid gap-8 md:mb-16 md:grid-cols-2 md:items-end md:gap-16">
      <h2 class="font-display text-4xl font-light leading-[1.08] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
        {before}{' '}<span class="text-plum">{accent}</span>{cierre(accent)}
      </h2>
      <p class="max-w-prose text-base leading-relaxed text-ink/75 md:pb-1 md:text-lg">{c.teamPage.body}</p>
    </div>

    {/* Sin aviso de "estructura preliminar" ni contadores de personas: lo
        primero es una nota interna y lo segundo se desactualiza solo (la
        dotación del estudio no está confirmada; ver company.headcount). */}
    <div class="mb-14 md:mb-16">
      <div class="mb-8 flex items-center gap-5">
        <h3 class="font-display text-2xl font-light text-ink md:text-3xl">{c.org.direccion}</h3>
        <span class="h-px flex-1 bg-plum/15" aria-hidden="true"></span>
      </div>
      <ul class="rejilla">
        {direccion.map((m) => (
          <li>
            <TeamCard name={m.name} role={c.roles[m.role]} img={m.img} />
          </li>
        ))}
      </ul>
    </div>

    <div data-areas class="scroll-mt-24">
      <div class="mb-6 flex items-center gap-5">
        <h3 class="font-display text-2xl font-light text-ink md:text-3xl">{c.org.areasTitle}</h3>
        <span class="h-px flex-1 bg-plum/15" aria-hidden="true"></span>
      </div>

      <div data-area-btns class="flex flex-wrap gap-2" role="group" aria-label={c.org.areasTitle}>
        {areas.map((a, i) => (
          <button
            type="button"
            data-area-btn={a.id}
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`area-${a.id}`}
            class="rounded-full border border-ink/25 px-5 py-2.5 font-body text-xs uppercase tracking-[0.12em] text-ink transition-colors duration-200 hover:border-plum hover:text-plum aria-expanded:border-ink aria-expanded:bg-ink aria-expanded:text-paper"
          >
            {a.nombre}
          </button>
        ))}
      </div>

      <div class="mt-8 md:mt-10">
        {areas.map((a, i) => (
          <div id={`area-${a.id}`} data-area-panel={a.id} hidden={i !== 0} class="scroll-mt-28 pb-10 last:pb-0">
            {/* El nombre del área ya está en el botón; solo se ve sin JavaScript,
                donde las áreas se apilan y cada una necesita su título. */}
            <h4 class="area-titulo sr-only font-display text-2xl font-light text-ink">{a.nombre}</h4>

            {a.jefaturas.length > 0 && (
              <ul class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
                {a.jefaturas.map((m) => (
                  <li>
                    <TeamRow lead name={m.name} role={c.roles[m.role]} img={m.img} />
                  </li>
                ))}
              </ul>
            )}

            {a.equipo.length > 0 && (
              <ul class:list={['grid gap-x-6 gap-y-3.5 sm:grid-cols-2 sm:gap-y-5 lg:grid-cols-3', a.jefaturas.length > 0 && 'mt-8 border-t border-plum/15 pt-8']}>
                {a.equipo.map((m) => (
                  <li>
                    <TeamRow name={m.name} role={c.roles[m.role]} img={m.img} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Las columnas de la Dirección van en CSS propio (no en clases de Tailwind):
     dos columnas en celular, tres en tablet y cuatro en escritorio, como la
     referencia. */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .rejilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .rejilla {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.875rem;
    }
  }
</style>

<script>
  (function () {
    var raiz = document.querySelector("[data-areas]");
    if (!raiz) return;

    var botones = Array.prototype.slice.call(raiz.querySelectorAll("[data-area-btn]"));
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function panel(id) {
      return raiz.querySelector('[data-area-panel="' + id + '"]');
    }

    function mostrar(id) {
      botones.forEach(function (b) {
        var suyo = b.getAttribute("data-area-btn") === id;
        b.setAttribute("aria-expanded", suyo ? "true" : "false");
        var p = panel(b.getAttribute("data-area-btn"));
        if (p) p.hidden = !suyo;
      });
    }

    botones.forEach(function (b) {
      b.addEventListener("click", function () {
        mostrar(b.getAttribute("data-area-btn"));
      });
    });

    // Un enlace a /equipo#area-impuestos abre esa área.
    // Se desplaza hasta el selector (no hasta el panel) para que se vean los
    // botones y se pueda cambiar de área sin subir.
    function desdeElAncla(alCargar) {
      var m = location.hash.match(/^#area-(.+)$/);
      if (!m || !panel(m[1])) return;
      mostrar(m[1]);
      var ir = function () {
        raiz.scrollIntoView({ behavior: quieto || alCargar ? "auto" : "smooth", block: "start" });
      };
      // Al cargar, el navegador hace su propio salto al ancla cuando termina de
      // cargar la página: se espera a eso para que no deje el scroll en el panel.
      if (alCargar && document.readyState !== "complete") {
        window.addEventListener("load", function () { setTimeout(ir, 0); });
      } else {
        ir();
      }
    }
    desdeElAncla(true);
    window.addEventListener("hashchange", function () { desdeElAncla(false); });
  })();
</script>
