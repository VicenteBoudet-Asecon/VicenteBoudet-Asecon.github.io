---
// Sello Asecon en la home, con el formato de la referencia (vinsonconsulting.cl,
// "El Sello Vinson"): sección oscura con los tres pilares en columnas numeradas.
// Usa los textos ya aprobados de `seal` (title, pillars, closing); la historia
// completa sigue en /sello-asecon.
//
// Primero fue un acordeón horizontal (la columna activa se abría y las otras
// quedaban como tiras con el título girado en vertical). Se cambió a tres
// columnas iguales por pedido del estudio: el texto girado se leía mal, los
// números de las tiras quedaban a distinta altura y mezclaba demasiados
// tamaños de letra. Ahora los tres pilares se ven siempre abiertos, con el
// mismo tamaño de título, de número y de texto.
import { getContent } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.seal.title;
const pilares = c.seal.pillars.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') }));
---

<section class="on-ink relative isolate overflow-hidden bg-ink text-paper">
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -left-24 -top-16 -z-10 hidden w-[30rem] -rotate-[8deg] opacity-[0.05] md:block"
  />
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -right-24 -z-10 hidden w-[34rem] rotate-[12deg] opacity-[0.05] md:block"
  />

  <div class="wrap py-14 md:py-20">
    <header class="max-w-3xl">
      <p class="font-body text-[11px] uppercase tracking-[0.22em] text-brass-light">{c.seal.eyebrow}</p>
      <h2 class="mt-4 text-balance font-display text-4xl leading-[1.08] tracking-tight text-white md:text-5xl lg:text-[3.4rem]">
        {before}{' '}<span class="text-plum-light">{accent}</span>{cierre(accent)}
      </h2>
    </header>

    <div data-pillars class="mt-10 grid gap-5 md:mt-12 lg:grid-cols-3 lg:gap-0 lg:border-l lg:border-white/15">
      {pilares.map((p) => (
        <article
          data-pillar
          class="pillar group relative flex flex-col border border-white/15 bg-white/[0.03] px-6 py-7 transition-colors duration-300 hover:bg-white/[0.06] lg:border-0 lg:border-r lg:bg-transparent lg:px-8 lg:hover:bg-white/[0.04]"
        >
          <span class="pillar-num font-display text-2xl text-brass-light" aria-hidden="true">{p.num}</span>
          <span class="mt-4 block h-px w-10 bg-brass-light/70 transition-all duration-300 group-hover:w-20" aria-hidden="true"></span>
          <h3 class="pillar-title mt-5 font-display text-2xl leading-snug text-white md:text-[1.7rem]">{p.title}</h3>
          <p class="pillar-body mt-4 max-w-[40ch] text-[15px] leading-relaxed text-paper/75 md:text-base">{p.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-6 md:mt-12 md:flex-row md:items-center md:justify-between md:gap-10">
      <p class="max-w-[46ch] font-display text-xl leading-snug text-paper md:text-2xl">{c.seal.closing}</p>
      <a
        href={path('seal', lang)}
        class="inline-flex shrink-0 items-center gap-2.5 self-start rounded-full border-2 border-brass px-6 py-3 font-body text-xs uppercase tracking-[0.18em] text-brass-light transition-colors duration-200 hover:bg-brass hover:text-ink md:self-auto"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4.5 3.5h8v8M12.5 3.5l-9 9" />
        </svg>
        {c.ui.learnAboutSeal}
      </a>
    </div>
  </div>
</section>
