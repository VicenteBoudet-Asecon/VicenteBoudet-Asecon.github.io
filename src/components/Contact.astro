---
// Página de Contacto con el formato de /contacto de la referencia
// (vinsonconsulting.cl): el titular a la izquierda y el formulario en una
// tarjeta blanca que se monta sobre el bloque de ubicación; debajo, los datos.
//
// Diferencia con la referencia: allí el bloque de ubicación es un mapa de
// Google incrustado. Acá NO: el sitio no carga terceros en sus páginas (las
// fuentes están autoalojadas, la CSP y las reglas 13 y 15 de
// scripts/validate.mjs lo vigilan) y un iframe de Google Maps mandaría la IP
// del visitante a Google sin aviso. Se deja la dirección y un enlace a Maps.
//
// El formulario (LeadForm) no se toca: solo cambia el tema a "light" porque
// ahora va sobre una tarjeta blanca; es el mismo tema que usa la portada.
import { company, getContent } from '../data/content';
import { getLangFromUrl, cierre } from '../i18n/config';
import LeadForm from './LeadForm.astro';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const L = c.contact.labels;
const [before, accent] = c.contact.title;
const tel = (n: string) => `tel:${n.replace(/\s/g, '')}`;
---

<section id="contacto" class="bg-paper">
  <div class="wrap grid grid-cols-1 gap-12 pb-14 pt-12 md:pt-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:pb-0">
    <div class="lg:pb-16">
      <p class="eyebrow">{c.contact.eyebrow}</p>
      <h1 class="mt-4 text-balance font-display text-4xl font-light leading-[1.08] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
        {before}{' '}<span class="text-plum">{accent}</span>{cierre(accent)}
      </h1>
      <p class="mt-6 max-w-[42ch] text-base leading-relaxed text-ink/75 md:text-lg">{c.contact.body}</p>

      {/*
        Qué esperar de la primera conversación. Baja la fricción de escribir:
        el visitante sabe a qué se está metiendo antes de dejar sus datos.
      */}
      <div class="mt-9 border-t border-plum/15 pt-8">
        <h2 class="font-display text-xl font-normal text-ink">{c.contact.whatHappensTitle}</h2>
        <ul class="mt-4 space-y-3">
          {c.contact.whatHappensItems.map((item) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink/75">
              <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-brass-dark" aria-hidden="true"></span>
              <span class="max-w-[46ch]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* La tarjeta baja 11rem sobre el bloque oscuro de abajo (solo en
        escritorio; en pantallas angostas queda en el flujo normal). */}
    <div class="relative z-10 bg-white p-7 shadow-2xl ring-1 ring-plum/10 md:p-10 lg:-mb-44">
      <LeadForm variant="full" source="contact-full" theme="light" />
    </div>
  </div>
</section>

{/* Bloque de ubicación: reemplaza al mapa incrustado de la referencia. La
    cuadrícula de fondo evoca un plano sin traer ninguna imagen de terceros. */}
<section class="on-ink relative isolate overflow-hidden bg-ink text-paper">
  <div
    class="pointer-events-none absolute inset-0 -z-20 opacity-60"
    style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 56px 56px;"
    aria-hidden="true"
  ></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-plum-deep/60 via-transparent to-plum/20" aria-hidden="true"></div>
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 right-[3%] -z-10 hidden h-[26rem] w-auto rotate-[10deg] opacity-[0.06] md:block"
  />

  <div class="wrap relative py-14 md:py-16 lg:grid lg:min-h-[20rem] lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-20">
    <div class="lg:pt-4">
      <p class="font-body text-[11px] uppercase tracking-[0.22em] text-brass-light">{L.office}</p>
      <p class="mt-4 max-w-[22ch] font-display text-3xl font-light leading-snug text-white md:text-4xl">{company.address}</p>
      <a
        href={company.mapUrl}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-2.5 rounded-full border-2 border-brass px-6 py-3 font-body text-xs uppercase tracking-[0.18em] text-brass-light transition-colors duration-200 hover:bg-brass hover:text-ink"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4.5 3.5h8v8M12.5 3.5l-9 9" />
        </svg>
        {L.mapCta}
      </a>
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="wrap py-14 md:py-16">
    <dl class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      <div>
        <dt class="font-body text-[11px] uppercase tracking-[0.2em] text-ink/70">{L.phone}</dt>
        <dd class="mt-3 space-y-1 font-display text-2xl font-light text-ink">
          <p><a href={tel(company.phone1)} class="transition-colors hover:text-plum">{company.phone1}</a></p>
          <p><a href={tel(company.phone2)} class="transition-colors hover:text-plum">{company.phone2}</a></p>
        </dd>
      </div>
      <div>
        <dt class="font-body text-[11px] uppercase tracking-[0.2em] text-ink/70">{L.email}</dt>
        <dd class="mt-3 font-display text-2xl font-light text-ink [overflow-wrap:anywhere]">
          <a href={`mailto:${company.email}`} class="transition-colors hover:text-plum">{company.email}</a>
        </dd>
      </div>
      <div>
        <dt class="font-body text-[11px] uppercase tracking-[0.2em] text-ink/70">{L.linkedin}</dt>
        <dd class="mt-3 font-display text-2xl font-light text-ink">
          <a href={company.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-plum">{L.linkedinCta}</a>
        </dd>
      </div>
    </dl>
  </div>
</section>
