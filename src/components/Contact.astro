---
import { company, getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';
import LeadForm from './LeadForm.astro';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const L = c.contact.labels;
const [before, accent] = c.contact.title;
---

<section id="contacto" class:list={['on-ink bg-ink text-paper', { 'border-t border-plum/15': bordered }]}>
  <div class:list={[
    'wrap grid grid-cols-1 gap-14 pb-20 md:pb-28 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20',
    bordered ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16',
  ]}>
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-brass-light">{c.contact.eyebrow}</p>
      <h1 class="mt-4 text-balance font-display text-4xl font-medium leading-tight text-paper md:text-5xl">
        {before}
        <span class="italic text-brass-light">{accent}</span>.
      </h1>
      <p class="mt-6 max-w-[42ch] text-paper/75">{c.contact.body}</p>

      <dl class="mt-10 space-y-5 border-t border-paper/15 pt-8 font-mono text-sm">
        <div class="flex flex-col gap-1">
          <dt class="text-xs uppercase tracking-[0.1em] text-paper/70">{L.phone}</dt>
          <dd>
            <a href={`tel:${company.phone1.replace(/\s/g, '')}`} class="hover:text-brass-light">{company.phone1}</a>
            <span class="text-paper/70"> &middot; </span>
            <a href={`tel:${company.phone2.replace(/\s/g, '')}`} class="hover:text-brass-light">{company.phone2}</a>
          </dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs uppercase tracking-[0.1em] text-paper/70">{L.email}</dt>
          <dd><a href={`mailto:${company.email}`} class="hover:text-brass-light">{company.email}</a></dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs uppercase tracking-[0.1em] text-paper/70">{L.office}</dt>
          <dd>
            <a href={company.mapUrl} target="_blank" rel="noopener" class="hover:text-brass-light">
              {company.address}
            </a>
          </dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-xs uppercase tracking-[0.1em] text-paper/70">{L.linkedin}</dt>
          <dd>
            <a href={company.linkedin} target="_blank" rel="noopener" class="hover:text-brass-light">
              {L.linkedinCta}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <LeadForm variant="full" source="contact-full" theme="dark" />
  </div>
</section>
