---
import Seal from './Seal.astro';
import { company, getContent } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.seal.title;
const alt = c.seal.officeAlt.replace('{address}', company.address);
---

<section id="sello" class:list={['on-ink relative overflow-hidden bg-ink text-paper', { 'border-t border-plum/15': bordered }]}>
  <!-- Un solo lavado de morado sobre la tinta, para que la sección no sea negra plana. -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-plum-deep/45 via-transparent to-plum/20"></div>

  <div class:list={['wrap relative grid grid-cols-1 items-center gap-14 pb-20 md:pb-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20', bordered ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16']}>
    <!-- El edificio de Asecon, con el sello estampado encima: la garantía sobre la casa. -->
    <figure class="relative mx-auto w-full max-w-[340px] bg-paper/5 lg:mx-0">
      <picture>
        <source type="image/webp" srcset="/sello/inmueble-asecon.webp" />
        <img
          src="/sello/inmueble-asecon.jpg"
          alt={alt}
          width="760"
          height="1102"
          loading="lazy"
          class="aspect-[760/1102] w-full border border-paper/15 object-cover shadow-2xl shadow-plum-deep/40"
          onerror="this.style.opacity='0'"
        />
      </picture>
      <div class="absolute -bottom-8 -right-8 hidden rounded-full bg-ink/85 p-2 backdrop-blur sm:block">
        <Seal size={150} onDark={true} />
      </div>
    </figure>

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-brass-light">{c.seal.eyebrow}</p>
      <h1 class="mt-4 text-balance font-display text-4xl font-medium leading-tight text-paper md:text-5xl">
        {before}
        <span class="italic text-brass-light">{accent}</span>{cierre(accent)}
      </h1>

      <p class="mt-7 max-w-[62ch] text-paper/80">{c.seal.intro}</p>

      {/* Tres pilares (en inglés la lista viene vacía por ahora y la página
          muestra solo la bajada y el cierre). */}
      {c.seal.pillars.length > 0 && (
        <ul class="mt-8 max-w-[62ch] space-y-5">
          {c.seal.pillars.map((p, i) => (
            <li class="flex gap-4 border-t border-paper/15 pt-5">
              <span class="font-mono text-xs tabular-nums text-brass-light">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="font-display text-lg font-medium leading-snug text-paper">{p.title}</h2>
                <p class="mt-1.5 text-[15px] leading-relaxed text-paper/75">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-8 max-w-[62ch] border-l-2 border-brass pl-5 text-paper/80">{c.seal.closing}</p>

      <a
        href={path('contact', lang)}
        class="mt-9 inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-ink transition-colors duration-200 hover:bg-brass-light"
      >
        {c.ui.requestInfo}
      </a>
    </div>
  </div>
</section>
