---
// Página del Sello Asecon con el formato de "Nosotros" de la referencia
// (vinsonconsulting.cl/nosotros): titular editorial, la sección oscura de los
// principios del sello, y una cita de cierre. Los textos son los ya aprobados
// de `seal` (title, intro, pillars, closing).
//
// PENDIENTE (Rafael, ver content.js): la garantía de hacerse cargo de giros o
// multas NO va en esta página hasta que se confirme si se publica; por eso no
// se usa `seal.teaserBody`.
//
// El encabezado (h1) y las migas viven en PageHero.astro, y el cierre con el
// botón de contacto en CtaBanner.astro (versión grande); este componente es el
// cuerpo entre los dos.
import Seal from './Seal.astro';
import { company, getContent } from '../data/content';
import { getLangFromUrl, cierre } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.seal.title;
const alt = c.seal.officeAlt.replace('{address}', company.address);
const pilares = c.seal.pillars.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') }));
---

<section id="sello" class="bg-white">
  <div class="wrap pb-16 pt-12 md:pb-24 md:pt-16">
    <div class="grid gap-8 md:grid-cols-2 md:items-end md:gap-16">
      <h2 class="text-balance font-display text-4xl font-light leading-[1.08] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
        {before}{' '}<span class="text-plum">{accent}</span>{cierre(accent)}
      </h2>
      <p class="font-display text-xl font-light leading-snug text-ink md:pb-1 md:text-2xl">{c.seal.intro}</p>
    </div>
  </div>
</section>

<section class="on-ink relative isolate overflow-hidden bg-ink text-paper">
  {/* Un solo lavado de morado sobre la tinta, para que la sección no sea negra plana. */}
  <div class="pointer-events-none absolute inset-0 -z-20 bg-gradient-to-br from-plum-deep/45 via-transparent to-plum/20"></div>
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -right-28 -z-10 hidden w-[36rem] rotate-[12deg] opacity-[0.05] md:block"
  />

  <div class="wrap grid grid-cols-1 items-center gap-16 py-20 md:py-28 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
    {/* El edificio de Asecon, con el sello estampado encima: la garantía sobre la casa. */}
    <figure class="relative mx-auto w-full max-w-[340px] bg-paper/5 lg:mx-0">
      <picture>
        <source type="image/webp" srcset="/sello/inmueble-asecon.webp" />
        <img
          src="/sello/inmueble-asecon.jpg"
          alt={alt}
          width="760"
          height="1102"
          loading="lazy"
          class="aspect-[760/1102] w-full border border-paper/15 object-cover shadow-2xl shadow-plum-deep/40"
          onerror="this.style.opacity='0'"
        />
      </picture>
      <div class="absolute -bottom-8 -right-8 hidden rounded-full bg-ink/85 p-2 backdrop-blur sm:block">
        <Seal size={150} onDark={true} />
      </div>
    </figure>

    {/* Los tres pilares, en filas grandes con el número a la izquierda (la
        lista de valores de la referencia). El número es decorativo: la lista es
        ordenada, así que el orden ya lo anuncia el lector de pantalla. */}
    <ol class="divide-y divide-white/15 border-y border-white/15">
      {pilares.map((p) => (
        <li class="grid grid-cols-[3.5rem_1fr] gap-x-6 py-8 md:grid-cols-[4.5rem_1fr] md:gap-x-8 md:py-10">
          <span class="font-display text-5xl font-light leading-none text-plum-light md:text-6xl" aria-hidden="true">{p.num}</span>
          <div>
            <h3 class="font-display text-2xl font-normal leading-snug text-white md:text-3xl">{p.title}</h3>
            <p class="mt-3 max-w-[48ch] text-[15px] leading-relaxed text-paper/75 md:text-base">{p.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="bg-paper">
  <div class="wrap py-20 md:py-28">
    <figure class="mx-auto max-w-4xl text-center">
      <span class="block font-display text-7xl font-bold leading-none text-plum" aria-hidden="true">&rdquo;</span>
      <blockquote class="mt-2 text-balance font-display text-3xl font-light leading-tight text-ink md:text-5xl">
        {c.seal.closing}
      </blockquote>
      <figcaption class="mt-9 inline-flex items-center gap-3 text-left">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-plum" aria-hidden="true">
          <img src="/brand/Isotipo.svg" alt="" class="h-6 w-auto" />
        </span>
        <span>
          <span class="block text-sm font-medium text-plum">{c.nav.seal}</span>
          <span class="block text-xs text-ink/70">{company.name}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>
