---
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.technology.title;
---

<section id="tecnologia" class:list={['', { 'border-t border-plum/15': bordered }]}>
  <div class="wrap py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">{c.technology.eyebrow}</p>
      <h1 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
        {before}
        <span class="italic text-plum">{accent}</span>.
      </h1>
      <p class="mt-6 max-w-[56ch] text-ink/70">{c.technology.body}</p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-x-12 md:gap-y-14">
      {c.technology.items.map((item, i) => (
        <li class="border-t border-plum/15 pt-6">
          <span class="font-mono text-xs text-brass-dark">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="mt-3 font-display text-xl font-medium leading-snug text-ink">{item.title}</h2>
          <p class="mt-2.5 max-w-[46ch] text-[15px] leading-relaxed text-ink/70">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
