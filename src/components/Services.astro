---
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.services.title;

const indice = c.services.ui.indexLabel;
const queIncluye = c.services.ui.includesLabel;
const consultar = c.services.ui.askAboutArea;
---

<!--
  Lista + detalle, uno al lado del otro en desktop (la lista queda fija con
  scroll propio mientras se lee el detalle): así comparar varias áreas no
  obliga a subir y bajar la página cada vez. En mobile se apilan. La textura
  de libro contable (.ledger-paper, definida en global.css pero sin usar en
  ningún otro lado) es la que le da identidad propia a esta página: tiene
  sentido acá porque es, literalmente, el índice de un libro contable.
-->
<section id="servicios" class:list={['ledger-paper bg-paper-dim/40', { 'border-t border-plum/15': bordered }]}>
  <div class:list={['wrap pb-20 md:pb-28', bordered ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16']}>
    <div class="mb-14 max-w-2xl">
      <p class="eyebrow mb-4">{c.services.eyebrow}</p>
      <h1 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
        {before}
        <span class="italic text-plum">{accent}</span>.
      </h1>
      <p class="mt-5 max-w-[58ch] text-ink/70">{c.services.body}</p>
    </div>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-12" data-services>
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-ink/70">
          {indice}
        </p>
        <div class="space-y-0.5">
          {c.serviceList.map((s, i) => (
            <button
              type="button"
              id={"servicio-" + s.code}
              data-card={s.code}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={"detalle-" + s.code}
              class="group flex w-full scroll-mt-28 items-baseline gap-3 rounded-r-md border-l-2 border-transparent py-2.5 pl-4 pr-3 text-left transition-colors hover:bg-paper/50 aria-expanded:border-plum aria-expanded:bg-paper"
            >
              <span class="font-mono text-[11px] tabular-nums text-ink/70 transition-colors group-aria-expanded:text-brass-dark">
                {s.code}
              </span>
              <span class="flex-1 font-display text-[15px] font-medium leading-snug text-ink transition-colors group-aria-expanded:text-plum">
                {s.name}
              </span>
            </button>
          ))}
        </div>
      </div>

      <div>
        {c.serviceList.map((s, i) => (
          <article id={"detalle-" + s.code} data-detail={s.code} hidden={i !== 0}>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-[17rem_minmax(0,1fr)] md:items-start md:gap-12">
              <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-paper-dim shadow-lg">
                <img
                  src={s.img}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                  onerror="this.style.opacity='0'"
                />
                <span class="absolute left-3 top-3 rounded-full bg-ink/85 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-paper backdrop-blur">
                  {s.code}
                </span>
              </div>

              <div class="relative">
                <span
                  class="pointer-events-none absolute -top-4 right-0 select-none font-display text-[6rem] leading-none text-plum/[0.07] md:-top-6 md:text-[8rem]"
                  aria-hidden="true"
                >
                  {s.code}
                </span>
                <h2 class="relative font-display text-2xl font-medium leading-snug text-ink md:text-3xl">{s.name}</h2>
                <p class="relative mt-4 max-w-[58ch] text-[15px] leading-relaxed text-ink/75">{s.summary}</p>
                {s.note && (
                  <p class="mt-4 max-w-[58ch] border-l-2 border-brass pl-4 text-[14px] italic leading-relaxed text-ink/60">
                    {s.note}
                  </p>
                )}

                <p class="ledger-rule mt-8 pt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ink/70">
                  {queIncluye}
                </p>
                <ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
                  {s.items.map((item) => (
                    <li class="flex gap-3 text-[13.5px] leading-relaxed text-ink/75">
                      <span class="mt-[8px] h-1 w-1 shrink-0 rounded-full bg-brass-dark"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={`${path('contact', lang)}?area=${s.code}`}
                  data-cta="service-area"
                  data-cta-location={`services-${s.code}`}
                  class="mt-8 inline-flex items-center gap-2 rounded-full bg-plum px-6 py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-paper transition-colors duration-200 hover:bg-plum-deep"
                >
                  {consultar}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector("[data-services]");
    if (!root) return;

    var cards = Array.prototype.slice.call(root.querySelectorAll("[data-card]"));
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var anchoAmplio = window.matchMedia("(min-width: 1024px)");

    function panel(code) {
      return root.querySelector('[data-detail="' + code + '"]');
    }

    function mostrar(code) {
      cards.forEach(function (c) {
        var suyo = c.getAttribute("data-card") === code;
        c.setAttribute("aria-expanded", suyo ? "true" : "false");
        var p = panel(c.getAttribute("data-card"));
        if (p) p.hidden = !suyo;
      });
    }

    cards.forEach(function (card) {
      card.addEventListener("click", function () {
        var code = card.getAttribute("data-card");
        mostrar(code);
        // En desktop la lista y el detalle están uno al lado del otro (la
        // lista queda fija): no hace falta mover el scroll. En mobile/tablet
        // siguen apilados, así que sí conviene bajar hasta el detalle.
        if (!anchoAmplio.matches) {
          var p = panel(code);
          if (p) p.scrollIntoView({ behavior: quieto ? "auto" : "smooth", block: "nearest" });
        }
      });
    });

    // Si se llega desde la portada con #servicio-04, se abre esa área.
    function desdeElAncla() {
      var h = location.hash;
      if (h.indexOf("#servicio-") !== 0) return;
      var code = h.slice(10);
      var p = panel(code);
      if (!p) return;
      mostrar(code);
      p.scrollIntoView({ behavior: quieto ? "auto" : "smooth", block: "start" });
    }
    desdeElAncla();
    window.addEventListener("hashchange", desdeElAncla);
  })();
</script>
