---
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.services.title;

const indice = lang === 'en' ? 'Practice areas' : 'Áreas de práctica';
const queIncluye = lang === 'en' ? 'What it covers' : 'Qué incluye';
const consultar = lang === 'en' ? 'Ask about this area' : 'Consultar por esta área';
---

<!--
  Vitrina + detalle: arriba las 8 áreas como tarjetas (la misma tarjeta que ya
  usa ServicesTeaser en Inicio), abajo un solo panel de detalle compartido que
  cambia según cuál se elija. Reemplaza el widget de índice + panel a dos
  columnas que tenía esta página antes.
-->
<section id="servicios" class:list={['bg-paper-dim/40', { 'border-t border-plum/15': bordered }]}>
  <div class="wrap py-20 md:py-28">
    <div class="mb-14 max-w-2xl">
      <p class="eyebrow mb-4">{c.services.eyebrow}</p>
      <h1 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
        {before}
        <span class="italic text-plum">{accent}</span>.
      </h1>
      <p class="mt-5 max-w-[58ch] text-ink/70">{c.services.body}</p>
    </div>

    <div data-services>
      <p class="mb-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ink/40">
        {indice}
      </p>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 lg:gap-6">
        {c.serviceList.map((s, i) => (
          <button
            type="button"
            id={"servicio-" + s.code}
            data-card={s.code}
            aria-expanded={i === 0 ? "true" : "false"}
            aria-controls={"detalle-" + s.code}
            class="group relative flex aspect-[4/5] scroll-mt-28 flex-col justify-end overflow-hidden rounded-lg bg-plum-deep text-left shadow-lg"
          >
            <img
              src={s.img}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover opacity-70 grayscale transition-all duration-500 group-hover:scale-105 group-hover:opacity-90 group-hover:grayscale-0 aria-expanded:opacity-90 aria-expanded:grayscale-0"
              onerror="this.style.display='none'"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-transparent"></div>
            <span
              class="pointer-events-none absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-brass transition-transform duration-300 aria-expanded:scale-x-100"
              aria-hidden="true"
            ></span>

            <div class="relative z-10 p-4 sm:p-5">
              <span class="font-mono text-[10px] text-brass-light sm:text-[11px]">{s.code}</span>
              <h2 class="mt-1.5 font-display text-[15px] font-medium leading-snug text-paper sm:text-base md:text-lg">
                {s.name}
              </h2>
            </div>
          </button>
        ))}
      </div>

      <div class="mt-14 border-t border-plum/15 pt-14 md:mt-20 md:pt-20">
        {c.serviceList.map((s, i) => (
          <article id={"detalle-" + s.code} data-detail={s.code} hidden={i !== 0}>
            <div class="grid grid-cols-1 gap-8 md:grid-cols-[17rem_minmax(0,1fr)] md:items-start md:gap-12">
              <div class="relative aspect-[4/5] overflow-hidden rounded-lg shadow-lg">
                <img
                  src={s.img}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                  onerror="this.style.display='none'"
                />
                <span class="absolute left-3 top-3 rounded-full bg-ink/85 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-paper backdrop-blur">
                  {s.code}
                </span>
              </div>

              <div>
                <h2 class="font-display text-2xl font-medium leading-snug text-ink md:text-3xl">{s.name}</h2>
                <p class="mt-4 max-w-[58ch] text-[15px] leading-relaxed text-ink/75">{s.summary}</p>
                {s.note && (
                  <p class="mt-4 max-w-[58ch] border-l-2 border-brass pl-4 text-[14px] italic leading-relaxed text-ink/60">
                    {s.note}
                  </p>
                )}

                <p class="ledger-rule mt-8 pt-5 font-mono text-[10px] uppercase tracking-[0.2em] text-ink/45">
                  {queIncluye}
                </p>
                <ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
                  {s.items.map((item) => (
                    <li class="flex gap-3 text-[13.5px] leading-relaxed text-ink/75">
                      <span class="mt-[8px] h-1 w-1 shrink-0 rounded-full bg-brass-dark"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={path('contact', lang)}
                  class="mt-8 inline-flex items-center gap-2 rounded-full bg-plum px-6 py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-paper transition-colors duration-200 hover:bg-plum-deep"
                >
                  {consultar}
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector("[data-services]");
    if (!root) return;

    var cards = Array.prototype.slice.call(root.querySelectorAll("[data-card]"));
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function panel(code) {
      return root.querySelector('[data-detail="' + code + '"]');
    }

    function mostrar(code) {
      cards.forEach(function (c) {
        var suyo = c.getAttribute("data-card") === code;
        c.setAttribute("aria-expanded", suyo ? "true" : "false");
        var p = panel(c.getAttribute("data-card"));
        if (p) p.hidden = !suyo;
      });
    }

    cards.forEach(function (card) {
      card.addEventListener("click", function () {
        var code = card.getAttribute("data-card");
        mostrar(code);
        var p = panel(code);
        if (p) p.scrollIntoView({ behavior: quieto ? "auto" : "smooth", block: "nearest" });
      });
    });

    // Si se llega desde la portada con #servicio-04, se abre esa área.
    function desdeElAncla() {
      var h = location.hash;
      if (h.indexOf("#servicio-") !== 0) return;
      var code = h.slice(10);
      var p = panel(code);
      if (!p) return;
      mostrar(code);
      p.scrollIntoView({ behavior: quieto ? "auto" : "smooth", block: "start" });
    }
    desdeElAncla();
    window.addEventListener("hashchange", desdeElAncla);
  })();
</script>
