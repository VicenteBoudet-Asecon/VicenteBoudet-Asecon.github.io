---
import { company, getContent } from '../data/content';
import { getLangFromUrl, cierre } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.clients.title;
const p = c.clients.proof;

const cmfLine = p.cmf.replace('{n}', company.cmfRegistry).replace('{year}', String(company.cmfSince));
const foundedLine = p.founded
  .replace('{year}', String(company.founded))
  .replace('{years}', String(company.years));

// Un ícono de línea por tipo de cliente (24x24, trazo 1.5, sin relleno: el mismo
// criterio que los de Tecnología). La clave sale de `icon` en content.js.
const ICONS: Record<string, string> = {
  factory: 'M3 21V12l6 3.5V12l6 3.5V5h4v16 M3 21h18 M7 18.5h1.5 M12 18.5h1.5',
  team: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M16 5.3a3 3 0 0 1 0 5.4 M18 14.3c1.8.7 3 2.5 3 4.7',
  growth: 'M3 17l6-6 4 4 8-8 M15 7h6v6',
  store: 'M3 9l1.5-5h15L21 9 M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0 M5 12v8h14v-8 M10 20v-5h4v5',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M3 12h18 M12 3c2.5 2.7 3.8 5.7 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z',
  building: 'M5 21V4h9v17 M14 9h5v12 M3 21h18 M8 8h3 M8 12h3 M8 16h3 M16.5 13h.01 M16.5 17h.01',
  heart: 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z',
  home: 'M3 11l9-7 9 7 M5 10v10h14V10 M10 20v-5h4v5',
  briefcase: 'M4 8h16v11H4z M9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8 M4 13h16 M11 13h2',
  gem: 'M6 4h12l3 5-9 11L3 9z M3 9h18 M9 4L7 9l5 11 5-11-2-5',
};

// Tres tonos de la marca que rotan tarjeta a tarjeta: con la misma franja en las
// diez, la fila se leía como una repetición. Con 5 columnas el patrón avanza en
// diagonal (A B C A B / C A B C A) en vez de formar columnas del mismo color.
const TONOS = ['bg-plum-deep', 'bg-plum', 'bg-ink-soft'];
---

<section id="clientes" class:list={['', { 'border-t border-plum/15': bordered }]}>
  <div class:list={['wrap pb-20 md:pb-28', bordered ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16']}>
    {/*
      Encabezado, luego los tipos de cliente a todo el ancho y, al final, el
      respaldo verificable. Los tipos no llevan número (a pedido del estudio): una
      numeración daría a entender que la lista es cerrada, y no lo es. Cada uno es
      una tarjeta con franja de color de la marca e ícono propio, como en
      Tecnología, sin fotos. Columnas: 5 verticales en escritorio ancho (dos
      filas), 2 horizontales (franja a la izquierda) en pantallas medianas, 2
      verticales en tablet y 1 en celular.
    */}
    <div class="max-w-5xl">
      <p class="eyebrow mb-4">{c.clients.eyebrow}</p>
      <h1 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
        {before}
        <span class="italic text-plum">{accent}</span>{cierre(accent)}
      </h1>
      <p class="mt-6 max-w-[96ch] text-ink/70">{c.clients.body}</p>
    </div>

    <div class="mt-12 md:mt-14">
      <h2 class="font-display text-2xl font-medium leading-snug text-ink md:text-3xl">{c.clients.typesTitle}</h2>
      <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-5">
        {c.clients.types.map((type, i) => (
          <li class="group flex flex-col overflow-hidden rounded-lg bg-paper shadow-md ring-1 ring-plum/10 transition-shadow duration-300 hover:shadow-xl lg:flex-row xl:flex-col">
            <div class:list={['relative flex h-24 items-center justify-center lg:h-auto lg:w-28 lg:shrink-0 xl:h-24 xl:w-auto', TONOS[i % TONOS.length]]}>
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-plum-mid/40 via-transparent to-transparent"></div>
              <svg
                class="relative h-9 w-9 text-brass-light transition-transform duration-300 group-hover:scale-110"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={ICONS[type.icon]} />
              </svg>
            </div>
            <div class="p-5 lg:flex-1 xl:flex-none">
              <h3 class="font-display text-[17px] font-medium leading-snug text-ink">{type.name}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-ink/70">{type.resolves}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/*
      Prueba verificable en vez de un testimonio anónimo: tres datos que
      cualquiera puede comprobar por su cuenta, uno de ellos con enlace
      a la fuente pública (el registro real de la CMF, no un buscador
      filtrado que podamos armar mal).
    */}
    <div class="mt-14 border-t border-plum/15 pt-8 md:mt-16">
      <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink/70">{p.label}</p>
      <div class="mt-5 grid grid-cols-1 gap-x-10 gap-y-4 md:grid-cols-3">
        <p class="flex flex-wrap items-baseline gap-x-2 text-[14px] text-ink/85">
          <span>{cmfLine}</span>
          <a href={company.cmfRegistryUrl} target="_blank" rel="noopener" class="font-mono text-xs uppercase tracking-[0.08em] text-plum hover:text-plum-deep">
            {p.cmfCta} &rarr;
          </a>
        </p>
        <p class="text-[14px] text-ink/85 md:border-l md:border-plum/15 md:pl-8">{foundedLine}</p>
        <p class="text-[14px] text-ink/85 md:border-l md:border-plum/15 md:pl-8">{p.seal}</p>
      </div>
    </div>

    {c.clients.logos.length > 0 && (
      <div class="mt-16 border-t border-plum/15 pt-10">
        <ul class="flex flex-wrap items-center gap-x-10 gap-y-6">
          {c.clients.logos.map((logo) => (
            <li>
              <img src={logo.src} alt={logo.alt} width="140" height="48" loading="lazy" class="h-8 w-auto object-contain opacity-80" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
