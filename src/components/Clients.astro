---
// Página de Clientes con el formato de /industrias de la referencia
// (vinsonconsulting.cl): titular editorial y una grilla de tarjetas — acá, los
// tipos de cliente a los que acompaña Asecon. Debajo, el respaldo verificable
// en una franja oscura.
//
// Dos decisiones del estudio que se mantienen:
//  · los tipos NO llevan número ("una numeración daría a entender que la lista
//    es cerrada, y no lo es"), por eso no se copió el ".01 … .16" de la
//    referencia;
//  · no hay fotos por tipo de cliente: cada tarjeta lleva un ícono de línea.
//    Antes el ícono iba sobre una franja de color con el isotipo de marca de
//    agua; repetida en las diez tarjetas (solo cambiaba el tono) parecía una
//    imagen repetida, así que ahora es una tarjeta limpia con el ícono en un
//    círculo.
// La referencia cierra la grilla con una flecha por tarjeta porque cada una
// lleva a su propia página; acá no hay páginas por tipo, así que no hay flecha.
import { company, getContent } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';
import ChannelLinks from './ChannelLinks.astro';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.clients.title;
const p = c.clients.proof;

const cmfLine = p.cmf.replace('{n}', company.cmfRegistry).replace('{year}', String(company.cmfSince));
const foundedLine = p.founded
  .replace('{year}', String(company.founded))
  .replace('{years}', String(company.years));

// Un ícono de línea por tipo de cliente (24x24, trazo 1.5, sin relleno: el mismo
// criterio que los de Tecnología). La clave sale de `icon` en content.js.
const ICONS: Record<string, string> = {
  factory: 'M3 21V12l6 3.5V12l6 3.5V5h4v16 M3 21h18 M7 18.5h1.5 M12 18.5h1.5',
  team: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M16 5.3a3 3 0 0 1 0 5.4 M18 14.3c1.8.7 3 2.5 3 4.7',
  growth: 'M3 17l6-6 4 4 8-8 M15 7h6v6',
  store: 'M3 9l1.5-5h15L21 9 M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0 M5 12v8h14v-8 M10 20v-5h4v5',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M3 12h18 M12 3c2.5 2.7 3.8 5.7 3.8 9S14.5 18.3 12 21c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z',
  building: 'M5 21V4h9v17 M14 9h5v12 M3 21h18 M8 8h3 M8 12h3 M8 16h3 M16.5 13h.01 M16.5 17h.01',
  heart: 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z',
  home: 'M3 11l9-7 9 7 M5 10v10h14V10 M10 20v-5h4v5',
  briefcase: 'M4 8h16v11H4z M9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8 M4 13h16 M11 13h2',
  gem: 'M6 4h12l3 5-9 11L3 9z M3 9h18 M9 4L7 9l5 11 5-11-2-5',
};

---

<section id="clientes" class="bg-white">
  <div class="wrap pb-20 pt-12 md:pb-28 md:pt-16">
    <div class="mb-12 grid gap-8 md:mb-16 md:grid-cols-2 md:items-end md:gap-16">
      <div>
        <p class="font-display text-xl text-ink md:text-2xl">{c.clients.typesTitle}</p>
        <h2 class="mt-3 font-display text-4xl font-light leading-[1.08] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
          {before}{' '}<span class="text-plum">{accent}</span>{cierre(accent)}
        </h2>
      </div>
      <p class="max-w-prose text-base leading-relaxed text-ink/75 md:pb-1 md:text-lg">{c.clients.body}</p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {c.clients.types.map((type) => (
        <li class="group flex flex-col bg-paper p-7 ring-1 ring-plum/10 transition duration-300 hover:-translate-y-1 hover:shadow-xl">
          <span class="grid h-14 w-14 place-items-center rounded-full bg-plum-deep text-brass-light transition-colors duration-300 group-hover:bg-plum">
            <svg
              class="h-7 w-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={ICONS[type.icon]} />
            </svg>
          </span>
          <h3 class="mt-6 font-display text-xl font-normal leading-snug text-ink">{type.name}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink/75">{type.resolves}</p>
        </li>
      ))}

      {/* Cierra la grilla: la décima tarjeta deja libres las dos últimas
          columnas de la fila, y ahí va la invitación a escribir (la misma
          pregunta que antes llevaba la franja CtaBanner de esta página). */}
      <li class="flex flex-col justify-between gap-8 border-l-4 border-brass bg-paper-dim p-8 sm:col-span-2 md:p-10">
        <h3 class="max-w-[24ch] font-display text-3xl font-light leading-tight text-ink md:text-4xl">
          {c.cta.clients}
        </h3>
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <a
            href={path('contact', lang)}
            data-cta="cta-primary"
            data-cta-location="clients-grid"
            class="inline-flex shrink-0 items-center gap-2.5 self-start rounded-full bg-plum px-7 py-4 font-body text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-plum-deep"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M4.5 3.5h8v8M12.5 3.5l-9 9" />
            </svg>
            {c.cta.action}
          </a>
          <div class="text-ink/70">
            <ChannelLinks show={['call', 'whatsapp', 'email']} context="clients-grid" />
          </div>
        </div>
      </li>
    </ul>

    {/* Logos con nombre real de cliente: vacío a propósito hasta que el estudio
        autorice cuáles pueden mostrarse. Sin entradas no se emite nada. */}
    {c.clients.logos.length > 0 && (
      <div class="mt-16 border-t border-plum/15 pt-10">
        <ul class="flex flex-wrap items-center gap-x-10 gap-y-6">
          {c.clients.logos.map((logo) => (
            <li>
              <img src={logo.src} alt={logo.alt} width="140" height="48" loading="lazy" class="h-8 w-auto object-contain opacity-80" />
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

{/* Hueco para Testimonials.astro (hoy sin testimonios autorizados: no emite nada). */}
<slot />

{/*
  Respaldo verificable en vez de un testimonio anónimo: tres datos que cualquiera
  puede comprobar por su cuenta, uno de ellos con enlace a la fuente pública (el
  registro real de la CMF, no un buscador filtrado que podamos armar mal).
*/}
<section class="on-ink relative isolate overflow-hidden bg-plum-deep text-paper">
  <img
    src="/brand/Isotipo.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-32 -right-24 -z-10 hidden w-[30rem] rotate-[12deg] opacity-[0.07] md:block"
  />
  <div class="wrap py-16 md:py-20">
    <p class="font-body text-[11px] uppercase tracking-[0.22em] text-brass-light">{p.label}</p>
    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0">
      <div class="md:pr-10">
        <p class="font-display text-xl font-light leading-snug text-white md:text-2xl">{cmfLine}</p>
        <a
          href={company.cmfRegistryUrl}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 font-body text-xs uppercase tracking-[0.12em] text-brass-light underline-offset-4 hover:underline"
        >
          {p.cmfCta} &rarr;
        </a>
      </div>
      <p class="font-display text-xl font-light leading-snug text-white md:border-l md:border-white/20 md:px-10 md:text-2xl">{foundedLine}</p>
      <p class="font-display text-xl font-light leading-snug text-white md:border-l md:border-white/20 md:pl-10 md:text-2xl">{p.seal}</p>
    </div>
  </div>
</section>
