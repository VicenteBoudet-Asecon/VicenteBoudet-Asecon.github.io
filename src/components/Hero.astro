---
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';
import { channels } from '../data/channels';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent, after] = c.hero.title;

// El destino y la etiqueta salen de la MISMA bandera: no pueden volver a
// desalinearse como pasaba antes ("Agendar una reunión" llevando a un
// formulario). Sin agenda en línea, el CTA honesto es escribir.
const primaryHref = channels.booking.ready ? path('booking', lang) : path('contact', lang);
const primaryLabel = channels.booking.ready ? c.ui.scheduleMeeting : c.ui.writeToUs;
---

<section id="inicio" class="on-ink relative flex h-[60vh] min-h-[560px] w-full items-end overflow-hidden bg-ink">
  {/*
    Sin <source> estático ni autoplay: el video (9,94 MB) solo se pide de
    red cuando el script de más abajo decide que vale la pena — nunca con
    prefers-reduced-motion, con Save-Data, o en un viewport angosto. Sin
    JavaScript o si esas condiciones no se cumplen, queda el poster nada más.
  */}
  <video
    id="hero-video"
    muted
    loop
    playsinline
    preload="none"
    poster="/hero/hero-main.jpg"
    class="absolute inset-0 h-full w-full object-cover"
    onerror="this.style.display='none'"
  ></video>
  <!-- Un solo degradado: dos capas superpuestas ensuciaban el color de marca. -->
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/30"></div>

  <button
    type="button"
    id="hero-video-toggle"
    hidden
    aria-pressed="true"
    aria-label={c.ui.pauseVideo}
    class="absolute bottom-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-ink/60 text-paper backdrop-blur transition-colors hover:bg-ink/80"
  >
    <svg id="hero-pause-icon" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
      <rect x="1.5" y="1" width="3.5" height="12" rx="1"></rect>
      <rect x="9" y="1" width="3.5" height="12" rx="1"></rect>
    </svg>
    <svg id="hero-play-icon" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true" class="hidden">
      <path d="M3 1.2v11.6c0 .8.9 1.3 1.6.9l9-5.8c.6-.4.6-1.4 0-1.8l-9-5.8c-.7-.4-1.6.1-1.6.9z"></path>
    </svg>
  </button>

  <div class="wrap relative z-10 animate-rise pb-16 pt-32 text-paper md:pb-20">
    <p class="eyebrow mb-5 text-brass-light">{c.hero.eyebrow}</p>
    <h1 class="max-w-[16ch] text-balance font-display text-[2.4rem] font-medium leading-[1.08] text-paper sm:text-5xl lg:text-[3.8rem]">
      {before}
      <span class="italic text-brass-light">{accent}</span>
      {after}
    </h1>

    <p class="mt-6 max-w-xl text-base leading-relaxed text-paper/85 md:text-lg">
      {c.hero.body}
    </p>

    <!-- Dos rutas: la de quien ya decidió y la de quien está comparando. -->
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={primaryHref}
        data-cta="hero-primary"
        data-cta-location="hero"
        class="inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-ink transition-colors duration-200 hover:bg-brass-light"
      >
        {primaryLabel}
      </a>
      <a
        href={path('services', lang)}
        data-cta="hero-secondary"
        data-cta-location="hero"
        class="inline-flex items-center gap-2 rounded-full border-2 border-paper/70 px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-paper transition-colors duration-200 hover:bg-paper hover:text-ink"
      >
        {c.ui.viewServices}
      </a>
    </div>
  </div>
</section>

<script define:vars={{ pauseLabel: c.ui.pauseVideo, playLabel: c.ui.playVideo }}>
  (function () {
    const video = document.getElementById('hero-video');
    const toggle = document.getElementById('hero-video-toggle');
    if (!video) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = navigator.connection && navigator.connection.saveData;
    const anchoSuficiente = window.matchMedia('(min-width: 1024px)').matches;

    // Ninguna de las tres condiciones se reevalúa en resize a propósito: es
    // la decisión con la que arrancó la visita, no algo que deba cambiar a
    // media carga.
    if (reduced || saveData || !anchoSuficiente) return;

    const source = document.createElement('source');
    source.src = '/hero/hero-video.mp4';
    source.type = 'video/mp4';
    video.appendChild(source);
    video.load();
    video.play().catch(() => {});

    if (!toggle) return;
    const iconPause = document.getElementById('hero-pause-icon');
    const iconPlay = document.getElementById('hero-play-icon');
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        toggle.setAttribute('aria-pressed', 'true');
        toggle.setAttribute('aria-label', pauseLabel);
        iconPause?.classList.remove('hidden');
        iconPlay?.classList.add('hidden');
      } else {
        video.pause();
        toggle.setAttribute('aria-pressed', 'false');
        toggle.setAttribute('aria-label', playLabel);
        iconPause?.classList.add('hidden');
        iconPlay?.classList.remove('hidden');
      }
    });
  })();
</script>
