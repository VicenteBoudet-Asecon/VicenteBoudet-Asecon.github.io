---
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const servicesHref = path('services', lang);

const prevLabel = lang === 'en' ? 'Previous services' : 'Servicios anteriores';
const nextLabel = lang === 'en' ? 'Next services' : 'Servicios siguientes';
---

<section class="border-t border-plum/15 bg-paper-dim/40">
  <div class="wrap pt-20 md:pt-28">
    <div class="mb-10 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="eyebrow mb-4">{c.servicesTeaser.eyebrow}</p>
        <h2 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
          {c.servicesTeaser.title}
        </h2>
        <p class="mt-5 max-w-[60ch] text-ink/70">{c.servicesTeaser.body}</p>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <button
          type="button"
          data-teaser-prev
          aria-label={prevLabel}
          class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-ink/25 text-ink transition-colors hover:bg-ink hover:text-paper"
        >
          &lsaquo;
        </button>
        <button
          type="button"
          data-teaser-next
          aria-label={nextLabel}
          class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-ink/25 text-ink transition-colors hover:bg-ink hover:text-paper"
        >
          &rsaquo;
        </button>
        <a
          href={servicesHref}
          class="ml-2 inline-flex items-center gap-2 rounded-full border-2 border-ink px-6 py-3 font-mono text-xs uppercase tracking-[0.18em] text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
        >
          {c.ui.viewAllServices}
        </a>
      </div>
    </div>
  </div>

  <div
    data-teaser-track
    class="scrollbar-none flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-6 md:px-10"
    style="scroll-padding-left: 1.5rem;"
  >
    {c.serviceList.map((s) => (
      <a
        href={servicesHref + "#servicio-" + s.code}
        class="group relative flex h-80 w-64 shrink-0 snap-start flex-col justify-end overflow-hidden rounded-lg bg-plum-deep shadow-lg sm:h-96 sm:w-72"
      >
        <img
          src={s.img}
          alt={s.name}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover opacity-70 grayscale transition-all duration-500 group-hover:scale-105 group-hover:opacity-90 group-hover:grayscale-0"
          onerror="this.style.display='none'"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-transparent"></div>

        <div class="relative z-10 p-6">
          <span class="font-mono text-xs text-brass-light">{s.code}</span>
          <h3 class="mt-2 font-display text-xl font-medium leading-snug text-paper">{s.name}</h3>
          <span class="mt-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-brass text-ink transition-transform duration-300 group-hover:translate-x-1">
            &rarr;
          </span>
        </div>
      </a>
    ))}
    <!-- Respiro final: sin esto la octava tarjeta queda pegada al borde. -->
    <span class="w-1 shrink-0" aria-hidden="true"></span>
  </div>

  <div class="wrap pb-20 md:pb-28">
    <div class="h-px w-full bg-plum/15" role="presentation">
      <div class="h-px bg-plum transition-all duration-300" style="width:12%" data-teaser-progress></div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .carousel-btn[disabled] {
    opacity: 0.3;
    cursor: default;
  }
  .carousel-btn[disabled]:hover {
    background: transparent;
    color: inherit;
  }
</style>

<script>
  (function () {
    var track = document.querySelector("[data-teaser-track]");
    if (!track) return;

    var prev = document.querySelector("[data-teaser-prev]");
    var next = document.querySelector("[data-teaser-next]");
    var barra = document.querySelector("[data-teaser-progress]");
    var quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function paso() {
      var card = track.querySelector("a");
      return card ? card.clientWidth + 20 : 300;
    }
    function tope() {
      return track.scrollWidth - track.clientWidth;
    }

    function pintar() {
      var max = tope();
      if (barra) {
        var visto = max > 0 ? (track.scrollLeft + track.clientWidth) / track.scrollWidth : 1;
        barra.style.width = Math.min(100, Math.round(visto * 100)) + "%";
      }
      if (prev) prev.toggleAttribute("disabled", track.scrollLeft <= 2);
      if (next) next.toggleAttribute("disabled", track.scrollLeft >= max - 2);
    }

    function mover(dir) {
      track.scrollBy({ left: dir * paso(), behavior: quieto ? "auto" : "smooth" });
    }

    prev && prev.addEventListener("click", function () { detener(); mover(-1); });
    next && next.addEventListener("click", function () { detener(); mover(1); });
    track.addEventListener("scroll", pintar, { passive: true });
    window.addEventListener("resize", pintar);

    // Avance automático: sin esto nadie descubre que hay ocho tarjetas y no cinco.
    // Se detiene apenas la persona toma el control, y no arranca si el sistema
    // pide menos movimiento.
    var reloj = null;
    function detener() {
      if (reloj) { clearInterval(reloj); reloj = null; }
    }
    function arrancar() {
      if (quieto || reloj) return;
      reloj = setInterval(function () {
        if (document.hidden) return;
        if (track.scrollLeft >= tope() - 2) {
          track.scrollTo({ left: 0, behavior: "smooth" });
        } else {
          mover(1);
        }
      }, 3800);
    }

    track.addEventListener("mouseenter", detener);
    track.addEventListener("focusin", detener);
    track.addEventListener("pointerdown", detener);
    track.addEventListener("wheel", detener, { passive: true });
    track.addEventListener("mouseleave", function () { if (reloj === null) arrancar(); });

    pintar();
    arrancar();
  })();
</script>
