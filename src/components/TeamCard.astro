---
// Tarjeta de una persona del equipo, con el formato de la referencia
// (vinsonconsulting.cl/equipo): retrato alto a sangre con el nombre y el cargo
// encima. Si la persona no tiene foto (`img: null`, ver content.js) o la foto
// no carga, queda el monograma de iniciales sobre el fondo morado — nunca una
// imagen rota. La referencia agrega una flecha porque cada tarjeta lleva a una
// ficha; acá no hay fichas, así que no hay flecha.
interface Props {
  name: string;
  role: string;
  img: string | null;
}
const { name, role, img } = Astro.props;

const partes = name.trim().split(/\s+/);
const iniciales = (partes[0][0] + (partes.length > 1 ? partes[partes.length - 1][0] : '')).toUpperCase();
---

<figure class="group relative isolate aspect-[4/5] overflow-hidden bg-plum-deep">
  <span class="absolute inset-0 grid place-items-center font-display text-5xl text-brass-light/70" aria-hidden="true">
    {iniciales}
  </span>
  {img && (
    <img
      src={img}
      alt=""
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none"
      onerror="this.remove()"
    />
  )}
  {/* El degradado va detrás del texto mismo (en la leyenda): con uno general
      las camisas y fondos claros de algunos retratos dejaban el nombre en 2,9:1. */}
  <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/85 to-transparent px-4 pb-4 pt-12 md:px-5 md:pb-5">
    <span class="block font-display text-base leading-tight text-white md:text-lg">{name}</span>
    <span class="mt-1 block text-xs leading-snug text-paper/80">{role}</span>
  </figcaption>
</figure>
