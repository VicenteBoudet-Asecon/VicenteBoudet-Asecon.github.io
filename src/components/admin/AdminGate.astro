---
// Cortina de acceso solo de cliente: no es seguridad real (el sitio es
// estático, sin backend), es un filtro contra visitas casuales mientras el
// panel solo tiene datos de ejemplo. Antes de compartir el enlace más allá
// del equipo interno, proteger /admin a nivel de hosting (Cloudflare Access,
// protección por contraseña de Netlify, Basic Auth, etc.) — ver README.
const PASSWORD_SHA256 = '8cdc6cc7380edf878c320e9df34c22d5fb7eb816d1bcfa785bd34e94bf640b75';
---

<div
  id="admin-gate"
  class="fixed inset-0 z-50 flex items-center justify-center bg-ink px-6"
  data-hash={PASSWORD_SHA256}
>
  <form id="admin-gate-form" class="w-full max-w-sm rounded-2xl border border-paper/15 bg-ink-soft p-8 shadow-2xl">
    <p class="eyebrow text-brass-light">Acceso restringido</p>
    <h1 class="mt-2 font-display text-2xl text-paper">Panel de Analytics</h1>
    <p class="mt-2 text-sm text-paper/70">
      Ingresa la clave del panel. Es un filtro simple para uso interno, no un inicio de sesión con roles.
    </p>

    <label for="admin-gate-input" class="mt-6 block font-mono text-xs uppercase tracking-[0.18em] text-paper/60">
      Clave
    </label>
    <input
      id="admin-gate-input"
      type="password"
      autocomplete="current-password"
      class="mt-2 w-full rounded-lg border border-paper/20 bg-ink px-4 py-3 text-paper outline-none focus-visible:border-brass"
      required
    />

    <p id="admin-gate-error" class="mt-3 hidden text-sm text-[#e66767]" role="alert">
      Clave incorrecta. Intenta de nuevo.
    </p>

    <button type="submit" class="btn-stamp-fill mt-6 w-full justify-center">Entrar</button>
  </form>
</div>

<script>
  async function sha256Hex(text: string) {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest('SHA-256', bytes);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  const STORAGE_KEY = 'asecon-admin-ok';
  const gate = document.getElementById('admin-gate') as HTMLDivElement;
  const dashboard = document.getElementById('admin-dashboard') as HTMLElement | null;
  const expectedHash = gate.dataset.hash;

  function reveal() {
    gate.remove();
    if (dashboard) dashboard.hidden = false;
  }

  if (sessionStorage.getItem(STORAGE_KEY) === '1') {
    reveal();
  } else {
    const form = document.getElementById('admin-gate-form') as HTMLFormElement;
    const input = document.getElementById('admin-gate-input') as HTMLInputElement;
    const error = document.getElementById('admin-gate-error') as HTMLParagraphElement;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const hash = await sha256Hex(input.value);
      if (hash === expectedHash) {
        sessionStorage.setItem(STORAGE_KEY, '1');
        reveal();
      } else {
        error.classList.remove('hidden');
        input.select();
      }
    });

    requestAnimationFrame(() => input.focus());
  }
</script>
