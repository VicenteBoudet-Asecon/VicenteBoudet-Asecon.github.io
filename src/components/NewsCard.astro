---
// Tarjeta de una nota, con el formato de la referencia (vinsonconsulting.cl/
// insights): la foto arriba y, montado sobre su borde inferior, un cuadro
// blanco con categoría, título, resumen y "Leer nota". La usan el listado
// (NewsList.astro) y el bloque "Otras notas" de cada nota (NewsPost.astro).
// Sin foto (el campo `image` es opcional en content/config.ts) queda un bloque
// morado con el isotipo, nunca un hueco.
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

interface Props {
  href: string;
  title: string;
  summary: string;
  category: string;
  image?: string;
  imageAlt?: string;
  dateLabel: string;
  isoDate: string;
  minutes: number;
  /** Nivel del título: h2 en el listado (no hay otro h2 encima), h3 en "Otras notas". */
  as?: 'h2' | 'h3';
}
const { href, title, summary, category, image, imageAlt, dateLabel, isoDate, minutes, as: Heading = 'h3' } = Astro.props;

const c = getContent(getLangFromUrl(Astro.url));
---

<a href={href} class="group flex h-full flex-col">
  <div class="relative aspect-[16/9] overflow-hidden bg-plum-deep">
    {image ? (
      <img
        src={image}
        alt={imageAlt || title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none"
        onerror="this.style.opacity='0'"
      />
    ) : (
      <img
        src="/brand/Isotipo.svg"
        alt=""
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 h-4/5 w-auto -translate-x-1/2 -translate-y-1/2 opacity-[0.12]"
      />
    )}
  </div>
  <div class="relative z-10 -mt-10 mx-4 flex flex-1 flex-col bg-white p-6 shadow-xl ring-1 ring-plum/10 transition duration-300 group-hover:-translate-y-1 group-hover:shadow-2xl md:mx-5 md:p-7">
    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink/70">
      <span class="text-plum-mid">{category}</span>
      <span aria-hidden="true"> · </span>
      <time datetime={isoDate}>{dateLabel}</time>
    </p>
    <Heading class="mt-3 font-display text-xl font-normal leading-snug text-ink transition-colors duration-200 group-hover:text-plum md:text-[1.4rem]">
      {title}
    </Heading>
    <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-ink/75">{summary}</p>
    <div class="mt-auto flex items-center justify-between gap-4 pt-6">
      <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-plum">
        {c.news.readMore}
        <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 8h10M8.5 3.5L13 8l-4.5 4.5" />
        </svg>
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink/70">
        {c.news.readingTime.replace('{n}', String(minutes))}
      </span>
    </div>
  </div>
</a>
