---
// Listado de Novedades con el formato de /insights de la referencia
// (vinsonconsulting.cl): titular editorial, filtros por categoría y una grilla
// de tarjetas con la foto y un cuadro de texto montado sobre ella. El banner y
// las migas viven en PageHero.astro. Se conservan los filtros propios de
// Asecon (la lista fija de categorías de content.js) y su script.
import { getCollection } from 'astro:content';
import { getContent } from '../data/content';
import { getLangFromUrl, path, cierre } from '../i18n/config';
import NewsCard from './NewsCard.astro';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.news.headline;

const posts = (await getCollection('posts', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const locale = lang === 'en' ? 'en-GB' : 'es-CL';
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const base = path('news', lang);

const readingTime = (body) => Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
// Filtros: la lista fija de content.js (si el idioma la define) y, al final,
// cualquier categoría de una nota que no esté en ella. Sin lista fija, solo las
// categorías de las notas publicadas.
const categories = [...new Set([...(c.news.categories ?? []), ...posts.map((p) => p.data.category)])];

const items = posts.map((post) => ({
  slug: post.slug,
  ...post.data,
  minutes: readingTime(post.body),
  dateLabel: fmt.format(post.data.date),
  isoDate: post.data.date.toISOString().slice(0, 10),
}));
---

<section id="novedades" class="bg-white">
  <div class="wrap pb-12 pt-12 md:pb-16 md:pt-16">
    <div class="grid gap-8 md:grid-cols-2 md:items-end md:gap-16">
      <h2 class="text-balance font-display text-4xl font-light leading-[1.08] tracking-tight text-ink md:text-5xl lg:text-[3.4rem]">
        {before}{' '}<span class="text-plum">{accent}</span>{cierre(accent)}
      </h2>
      <p class="max-w-prose text-base leading-relaxed text-ink/75 md:pb-1 md:text-lg">{c.news.body}</p>
    </div>

    {categories.length > 1 && (
      <div class="mt-12 flex flex-wrap items-center gap-2" data-filters role="group" aria-labelledby="news-filter-label">
        <span id="news-filter-label" class="mr-1 font-mono text-[10px] uppercase tracking-[0.16em] text-ink/70">
          {c.news.filterLabel}
        </span>
        <button type="button" data-filter="*" class="filter-chip is-active" aria-pressed="true">
          {c.news.allCategories}
        </button>
        {categories.map((cat) => (
          <button type="button" data-filter={cat} class="filter-chip" aria-pressed="false">{cat}</button>
        ))}
      </div>
    )}

    {/* Anuncia cuántas notas quedan tras filtrar: el chip activo cambia de
        color, pero eso no le dice nada a quien usa lector de pantalla. */}
    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
  </div>
</section>

<section class="bg-paper">
  <div class="wrap pb-20 pt-16 md:pb-28 md:pt-20">
    {items.length === 0 ? (
      <p class="font-mono text-sm text-ink/70">{c.news.empty}</p>
    ) : (
      <div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3" data-posts>
          {items.map((it) => (
            <article class="news-item" data-category={it.category}>
              <NewsCard
                as="h2"
                href={`${base}/${it.slug}`}
                title={it.title}
                summary={it.summary}
                category={it.category}
                image={it.image}
                imageAlt={it.imageAlt}
                dateLabel={it.dateLabel}
                isoDate={it.isoDate}
                minutes={it.minutes}
              />
            </article>
          ))}
        </div>

        <p class="mt-10 hidden font-mono text-sm text-ink/70" data-no-matches>{c.news.noMatches}</p>
      </div>
    )}
  </div>
</section>

<style>
  .filter-chip {
    border: 1px solid rgba(107, 31, 126, 0.25);
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(31, 23, 38, 0.7);
    background: transparent;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }
  .filter-chip:hover {
    color: #6b1f7e;
    border-color: rgba(107, 31, 126, 0.5);
  }
  .filter-chip.is-active {
    background: #1f1726;
    border-color: #1f1726;
    color: #f4f1f6;
  }

  .news-item[hidden] {
    display: none;
  }
</style>

<script define:vars={{ resultsLabel: c.news.resultsLabel }}>
  (function () {
    var filters = document.querySelector("[data-filters]");
    var grid = document.querySelector("[data-posts]");
    if (!grid) return;

    var items = Array.prototype.slice.call(grid.querySelectorAll(".news-item"));
    var empty = document.querySelector("[data-no-matches]");
    var status = document.querySelector("[data-filter-status]");

    function apply(value) {
      var visible = [];
      items.forEach(function (el) {
        var match = value === "*" || el.getAttribute("data-category") === value;
        el.hidden = !match;
        if (match) visible.push(el);
      });
      if (empty) empty.classList.toggle("hidden", visible.length > 0);
      if (status) status.textContent = resultsLabel.replace("{n}", visible.length);
    }

    if (filters) {
      filters.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-filter]");
        if (!btn) return;
        filters.querySelectorAll("[data-filter]").forEach(function (b) {
          var activo = b === btn;
          b.classList.toggle("is-active", activo);
          b.setAttribute("aria-pressed", String(activo));
        });
        apply(btn.getAttribute("data-filter"));
      });
    }
  })();
</script>
