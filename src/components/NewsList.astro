---
import { getCollection } from 'astro:content';
import { getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';

interface Props {
  bordered?: boolean;
}
const { bordered = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.news.title;

const posts = (await getCollection('posts', (p) => p.data.lang === lang && !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const locale = lang === 'en' ? 'en-GB' : 'es-CL';
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const base = path('news', lang);

const readingTime = (body) => Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
const categories = [...new Set(posts.map((p) => p.data.category))];

const items = posts.map((post) => ({
  slug: post.slug,
  ...post.data,
  minutes: readingTime(post.body),
  dateLabel: fmt.format(post.data.date),
  isoDate: post.data.date.toISOString().slice(0, 10),
}));
---

<section id="novedades" class:list={['', { 'border-t border-plum/15': bordered }]}>
  <div class:list={['wrap pb-20 md:pb-28', bordered ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16']}>
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">{c.news.eyebrow}</p>
        <h1 class="font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
          {before}
          <span class="italic text-plum">{accent}</span>.
        </h1>
        <p class="mt-6 max-w-[56ch] text-ink/70">{c.news.body}</p>
      </div>

      {categories.length > 1 && (
        <div class="flex flex-wrap items-center gap-2" data-filters>
          <span class="mr-1 font-mono text-[10px] uppercase tracking-[0.16em] text-ink/40">
            {c.news.filterLabel}
          </span>
          <button type="button" data-filter="*" class="filter-chip is-active">
            {c.news.allCategories}
          </button>
          {categories.map((cat) => (
            <button type="button" data-filter={cat} class="filter-chip">{cat}</button>
          ))}
        </div>
      )}
    </div>

    {items.length === 0 ? (
      <p class="mt-16 font-mono text-sm text-ink/50">{c.news.empty}</p>
    ) : (
      <div>
        <div class="mt-16 md:mt-20" data-posts>
          {items.map((it, i) => (
            <article
              class:list={['news-item', { 'border-t border-plum/15': i > 0 }]}
              data-category={it.category}
            >
              <a
                href={base + '/' + it.slug}
                class:list={[
                  'group grid grid-cols-1 items-center gap-8 py-12 md:gap-14 md:py-16',
                  it.image && 'md:grid-cols-2',
                ]}
              >
                {it.image && (
                  <div class:list={['relative overflow-hidden rounded-lg', { 'md:order-2': i % 2 === 1 }]}>
                    <img
                      src={it.image}
                      alt={it.imageAlt || it.title}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      onerror="this.closest('div').remove()"
                    />
                    <span class="absolute left-4 top-4 rounded-full bg-ink/85 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-paper backdrop-blur">
                      {it.category}
                    </span>
                  </div>
                )}

                <div class:list={{ 'max-w-[52ch]': !it.image }}>
                  <div class="flex items-center gap-3">
                    {!it.image && (
                      <>
                        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-brass-dark">
                          {it.category}
                        </span>
                        <span class="h-px flex-1 bg-plum/20"></span>
                      </>
                    )}
                    <time datetime={it.isoDate} class="font-mono text-[11px] tabular-nums text-ink/45">
                      {it.dateLabel}
                    </time>
                  </div>

                  <h2 class="news-title mt-4 font-display text-2xl font-medium leading-snug text-ink transition-colors duration-200 group-hover:text-plum md:text-[1.75rem]">
                    {it.title}
                  </h2>

                  <p class="mt-3 max-w-[54ch] text-[15px] leading-relaxed text-ink/70">
                    {it.summary}
                  </p>

                  <div class="mt-7 flex flex-wrap items-center gap-5">
                    <span class="btn-stamp-fill group-hover:bg-plum-deep">
                      {c.news.readMore}
                      <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                    </span>
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink/45">
                      {c.news.readingTime.replace('{n}', it.minutes)}
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        <p class="mt-10 hidden font-mono text-sm text-ink/50" data-no-matches>{c.news.noMatches}</p>
      </div>
    )}
  </div>
</section>

<style>
  .filter-chip {
    border: 1px solid rgba(107, 31, 126, 0.25);
    border-radius: 9999px;
    padding: 0.4rem 0.85rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(31, 23, 38, 0.65);
    background: transparent;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }
  .filter-chip:hover {
    color: #6b1f7e;
    border-color: rgba(107, 31, 126, 0.5);
  }
  .filter-chip.is-active {
    background: #1f1726;
    border-color: #1f1726;
    color: #f4f1f6;
  }

  .news-item[hidden] {
    display: none;
  }
  .news-item:first-child {
    border-top: none;
  }
</style>

<script>
  (function () {
    var filters = document.querySelector("[data-filters]");
    var grid = document.querySelector("[data-posts]");
    if (!grid) return;

    var items = Array.prototype.slice.call(grid.querySelectorAll(".news-item"));
    var empty = document.querySelector("[data-no-matches]");

    function apply(value) {
      var visible = [];
      items.forEach(function (el) {
        var match = value === "*" || el.getAttribute("data-category") === value;
        el.hidden = !match;
        el.classList.toggle("border-t", visible.length > 0);
        el.classList.toggle("border-plum/15", visible.length > 0);
        if (match) visible.push(el);
      });
      if (empty) empty.classList.toggle("hidden", visible.length > 0);
    }

    if (filters) {
      filters.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-filter]");
        if (!btn) return;
        filters.querySelectorAll("[data-filter]").forEach(function (b) {
          b.classList.toggle("is-active", b === btn);
        });
        apply(btn.getAttribute("data-filter"));
      });
    }
  })();
</script>
