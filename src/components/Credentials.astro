---
// Cifras de respaldo, con el formato de la referencia (vinsonconsulting.cl):
// números grandes y livianos, centrados, con su rótulo debajo. Va después del
// bloque de servicios. Ojo: aquí no hay conteo animado a propósito — dos de
// las cuatro cifras no son numéricas ("N° 418", "Desde 1996", "Siempre"), y
// un registro CMF que "sube" de 0 a 418 no tendría sentido.
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
---

<section class="bg-paper">
  <div class="wrap py-16 md:py-20">
    <p class="mb-10 text-center font-mono text-[11px] uppercase tracking-[0.22em] text-plum-mid">
      {c.credentials.label}
    </p>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">
      {c.credentials.items.map((item) => (
        <div class="text-center">
          <dt class="font-display text-4xl font-light leading-none tracking-tight text-plum md:text-5xl">{item.value}</dt>
          <dd class="mx-auto mt-4 max-w-[26ch] text-[14px] leading-snug text-ink/75">{item.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
