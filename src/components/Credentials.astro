---
// Franja de respaldo. Va inmediatamente bajo la portada, antes de cualquier
// servicio: es la prueba de que Asecon puede hacer lo que dice.
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
---

<section class="on-ink border-b border-plum/15 bg-ink text-paper">
  <div class="wrap py-10 md:py-12">
    <p class="mb-7 font-mono text-[11px] uppercase tracking-[0.22em] text-brass-light">
      {c.credentials.label}
    </p>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-8 lg:grid-cols-4">
      {c.credentials.items.map((item) => (
        <div class="border-t border-paper/25 pt-4">
          <dt class="font-mono text-xl leading-none text-brass-light md:text-2xl">{item.value}</dt>
          <dd class="mt-2.5 max-w-[24ch] text-[13px] leading-snug text-paper/70">{item.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
