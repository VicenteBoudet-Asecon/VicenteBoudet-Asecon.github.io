---
// Nota individual con el formato de los artículos de la referencia
// (vinsonconsulting.cl): botón para volver, una imagen ancha con la tarjeta del
// título montada sobre su borde, el cuerpo debajo y, al final, otras notas con
// las mismas tarjetas del listado.
import { company, getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';
import { articleSchema } from '../lib/schema';
import NewsCard from './NewsCard.astro';

interface Props {
  post: any;
  related?: any[];
}
const { post, related = [] } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const locale = lang === 'en' ? 'en-GB' : 'es-CL';
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const fmtCorto = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const base = path('news', lang);
const minutosDe = (body: string) => Math.max(1, Math.round(body.trim().split(/\s+/).length / 200));
const minutes = minutosDe(post.body);

// Article/BlogPosting, además del WebPage que ya emite Layout.astro para
// esta página (no en su lugar: son dos entidades distintas, y Google
// documenta que pueden convivir).
const site = Astro.site ?? new URL('https://aseconsa.com');
const newsBase = lang === 'en' ? '/en/insights' : '/novedades';
const canonical = new URL(`${newsBase}/${post.slug}/`, site).href;
const article = articleSchema({
  site,
  company,
  canonical,
  title: post.data.title,
  summary: post.data.summary,
  datePublished: post.data.date.toISOString(),
  image: post.data.image,
});
// set:html no escapa nada, y el título y el resumen llegan del CMS: sin
// este replace, un título con "</script>" cerraría el bloque y lo que siga
// correría como HTML (XSS guardado). < es el mismo "<" para el parser
// de JSON, así que el dato no cambia.
const articleJson = JSON.stringify(article).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={articleJson} />

<article class="bg-white">
  <div class="wrap pb-16 pt-8 md:pb-24 md:pt-12">
    <a
      href={base}
      class="inline-flex items-center gap-2 rounded-full border border-ink/25 px-5 py-2.5 font-body text-[11px] uppercase tracking-[0.14em] text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
    >
      <span aria-hidden="true">&larr;</span> {c.news.backToList}
    </a>

    <div class="relative mt-8 md:mt-10">
      {post.data.image && (
        <div class="overflow-hidden bg-ink">
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            loading="eager"
            decoding="async"
            class="aspect-[16/10] w-full object-cover md:aspect-[21/9]"
            onerror="this.style.opacity='0'"
          />
        </div>
      )}

      {/* La tarjeta del título se monta sobre el borde inferior de la imagen. */}
      <header
        class:list={[
          'relative z-10 bg-white p-7 shadow-xl ring-1 ring-plum/10 md:p-10',
          post.data.image ? '-mt-12 mx-4 md:-mt-28 md:mx-0 md:max-w-[40rem]' : 'max-w-[46rem]',
        ]}
      >
        <p class="font-body text-[11px] uppercase tracking-[0.18em] text-plum-mid">
          {post.data.category}
        </p>
        <h1 class="mt-4 text-balance font-display text-3xl leading-tight text-ink md:text-[2.5rem]">
          {post.data.title}
        </h1>
        <p class="mt-5 text-[15px] leading-relaxed text-ink/70">{post.data.summary}</p>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 font-body text-xs text-ink/70">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt.format(post.data.date)}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{c.news.readingTime.replace('{n}', String(minutes))}</span>
        </p>
      </header>
    </div>

    <div class="prose-asecon mt-14 max-w-[68ch] md:mt-16">
      <slot />
    </div>
  </div>

  {related.length > 0 && (
    <div class="bg-paper">
      <div class="wrap py-16 md:py-20">
        <h2 class="mb-12 font-display text-3xl leading-tight text-ink md:text-4xl">{c.news.alsoRead}</h2>
        <ul class="grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <li>
              <NewsCard
                as="h3"
                href={`${base}/${r.slug}`}
                title={r.data.title}
                summary={r.data.summary}
                category={r.data.category}
                image={r.data.image}
                imageAlt={r.data.imageAlt}
                dateLabel={fmtCorto.format(r.data.date)}
                isoDate={r.data.date.toISOString().slice(0, 10)}
                minutes={minutosDe(r.body)}
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
</article>

<style is:global>
  /* Tipografía del cuerpo de las notas. Se escribe acá y no en cada archivo .md
     para que todas las notas se vean iguales sin que el autor piense en formato. */
  .prose-asecon p {
    margin-bottom: 1.35rem;
    line-height: 1.75;
    color: rgba(31, 23, 38, 0.82);
  }
  .prose-asecon p:last-child {
    margin-bottom: 0;
  }
  .prose-asecon h2 {
    margin: 2.75rem 0 0.9rem;
    font-family: 'Fraunces', serif;
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.25;
    color: #1F1726;
  }
  .prose-asecon h3 {
    margin: 2rem 0 0.65rem;
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #1F1726;
  }
  .prose-asecon ul,
  .prose-asecon ol {
    margin: 0 0 1.35rem 1.1rem;
    padding: 0;
  }
  .prose-asecon li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: rgba(31, 23, 38, 0.82);
  }
  .prose-asecon a {
    color: #6B1F7E;
    text-underline-offset: 2px;
  }
  .prose-asecon a:hover {
    color: #9C7635;
  }
  .prose-asecon strong {
    font-weight: 600;
    color: #1F1726;
  }
  .prose-asecon blockquote {
    margin: 2rem 0;
    border-left: 2px solid #C79A4B;
    padding-left: 1.5rem;
    font-family: 'Fraunces', serif;
    font-style: normal;
    font-size: 1.125rem;
    color: #1F1726;
  }
</style>
