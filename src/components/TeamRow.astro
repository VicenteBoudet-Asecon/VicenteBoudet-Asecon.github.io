---
// Persona en formato compacto: foto circular al lado del nombre y el cargo. Es la
// versión "de lista" de TeamCard.astro: una tarjeta alta por persona hacía que 40
// personas ocuparan casi siete pantallas, así que fuera de la Dirección la gente
// se muestra por área y en filas de este tamaño.
//
// `lead` (jefaturas del área) es algo más grande y va sobre fondo suave. Sin foto
// (`img: null`, ver content.js) o si la foto no carga, queda el monograma de
// iniciales sobre el fondo morado — nunca una imagen rota.
interface Props {
  name: string;
  role: string;
  img: string | null;
  lead?: boolean;
}
const { name, role, img, lead = false } = Astro.props;

const partes = name.trim().split(/\s+/);
const iniciales = (partes[0][0] + (partes.length > 1 ? partes[partes.length - 1][0] : '')).toUpperCase();
---

<div class:list={['flex items-center gap-4', lead && 'bg-paper p-3 ring-1 ring-plum/10 md:p-4']}>
  <span
    class:list={[
      'relative grid shrink-0 place-items-center overflow-hidden rounded-full bg-plum-deep font-display font-light text-brass-light/80',
      lead ? 'h-16 w-16 text-xl md:h-20 md:w-20 md:text-2xl' : 'h-12 w-12 text-base md:h-14 md:w-14 md:text-lg',
    ]}
    aria-hidden="true"
  >
    {iniciales}
    {img && (
      <img
        src={img}
        alt=""
        width="160"
        height="160"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
        onerror="this.remove()"
      />
    )}
  </span>
  <span class="min-w-0">
    <span class:list={['block font-display leading-tight text-ink', lead ? 'text-lg' : 'text-base']}>{name}</span>
    <span class="mt-1 block text-[14px] leading-snug text-ink/70">{role}</span>
  </span>
</div>
