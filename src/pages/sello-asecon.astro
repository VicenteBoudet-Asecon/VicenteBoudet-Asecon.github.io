---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Sello from '../components/Sello.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.sealTitle}
  description={c.meta.sealDescription}
>
  <Header />
  <main id="contenido">
    <PageHero
      title={c.nav.seal}
      pattern={1}
      crumbs={[{ label: c.nav.seal }]}
    />
    <Sello />
    <CtaBanner variant="seal" headline={c.seal.ctaTitle} />
  </main>
  <Footer />
</Layout>
