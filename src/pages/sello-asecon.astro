---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Sello from '../components/Sello.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.sealTitle}
  description={c.meta.sealDescription}
>
  <Header />
  <main id="contenido">
    <Sello bordered={false} />
    <CtaBanner variant="seal" />
  </main>
  <Footer />
</Layout>
