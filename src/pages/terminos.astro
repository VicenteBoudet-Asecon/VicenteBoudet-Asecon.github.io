---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LegalPage from '../components/LegalPage.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
const doc = c.legal.terms;
---

<Layout title={doc.metaTitle} description={doc.metaDescription} noindex={true}>
  <Header />
  <main id="contenido">
    <LegalPage docKey="terms" />
  </main>
  <Footer />
</Layout>
