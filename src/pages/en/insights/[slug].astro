---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import NewsPost from '../../../components/NewsPost.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import Footer from '../../../components/Footer.astro';
import { getContent } from '../../../data/content';
import { path, languages } from '../../../i18n/config';

export async function getStaticPaths() {
  const all = await getCollection('posts', (p) => !p.data.draft);
  const en = all
    .filter((p) => p.data.lang === 'en')
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return en.map((post) => {
    const pair = all.find((p) => p.data.lang === 'es' && p.data.pair === post.data.pair);
    return {
      params: { slug: post.slug },
      props: {
        post,
        related: en.filter((p) => p.slug !== post.slug).slice(0, 2),
        pairSlug: pair?.slug ?? null,
      },
    };
  });
}

const { post, related, pairSlug } = Astro.props;
const { Content } = await post.render();

const site = Astro.site ?? new URL('https://aseconsa.com');
const c = getContent('en');

const alternates = pairSlug
  ? [
      { code: 'es', hreflang: languages.es.htmlLang, href: new URL(`/novedades/${pairSlug}/`, site).href },
      { code: 'en', hreflang: languages.en.htmlLang, href: new URL(`/en/insights/${post.slug}/`, site).href },
    ]
  : [];
---

<Layout
  title={`${post.data.title} | Asecon S.A.`}
  description={post.data.summary}
  image={post.data.image}
  alternates={alternates}
  breadcrumbs={[
    { name: c.nav.news, path: path('news', 'en') },
    { name: post.data.title, path: `/en/insights/${post.slug}/` },
  ]}
>
  <Header />
  <main id="contenido">
    <NewsPost post={post} related={related}>
      <Content />
    </NewsPost>
    <CtaBanner variant="home" />
  </main>
  <Footer />
</Layout>
