---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import NewsList from '../../../components/NewsList.astro';
import LeadMagnet from '../../../components/LeadMagnet.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import Footer from '../../../components/Footer.astro';
import { getContent } from '../../../data/content';
import { getLangFromUrl } from '../../../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout title={c.meta.newsTitle} description={c.meta.newsDescription}>
  <Header />
  <main id="contenido">
    <NewsList bordered={false} />
    {/* LeadMagnet renders nothing while company.leadMagnetFile is empty:
        CtaBanner is the page's guaranteed closing CTA, always. */}
    <LeadMagnet />
    <CtaBanner variant="home" />
  </main>
  <Footer />
</Layout>
