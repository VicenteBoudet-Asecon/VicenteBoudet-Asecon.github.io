---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import ServicesMosaic from '../../components/ServicesMosaic.astro';
import ServicesSelector from '../../components/ServicesSelector.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import { getContent } from '../../data/content';
import { getLangFromUrl } from '../../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.servicesTitle}
  description={c.meta.servicesDescription}
>
  <Header />
  <main id="contenido">
    <PageHero
      title={c.nav.services}
      image="/office/conoce-asecon.webp"
      focus="object-[50%_24%]"
      veil="from-ink/55 via-plum-deep/35 to-ink/60"
      crumbs={[{ label: c.nav.services }]}
    />
    <ServicesMosaic />
    <ServicesSelector />
    <LeadMagnet />
    <FAQ />
    <CtaBanner variant="services" headline={c.services.page.ctaTitle} />
  </main>
  <Footer />
</Layout>
