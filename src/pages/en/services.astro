---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Services from '../../components/Services.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import FAQ from '../../components/FAQ.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import { getContent } from '../../data/content';
import { getLangFromUrl } from '../../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.servicesTitle}
  description={c.meta.servicesDescription}
>
  <Header />
  <main id="contenido">
    <Services bordered={false} />
    <LeadMagnet />
    <FAQ />
    <CtaBanner variant="services" />
  </main>
  <Footer />
</Layout>
