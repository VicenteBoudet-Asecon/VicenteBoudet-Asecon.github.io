---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Credentials from '../../components/Credentials.astro';
import ServicesTeaser from '../../components/ServicesTeaser.astro';
import SelloTeaser from '../../components/SelloTeaser.astro';
import TeamStrip from '../../components/TeamStrip.astro';
import ContactTeaser from '../../components/ContactTeaser.astro';
import Footer from '../../components/Footer.astro';
import { getContent } from '../../data/content';
import { getLangFromUrl } from '../../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout preloadImage="/hero/hero-main.webp">
  <Header />
  <main id="contenido">
    <Hero />
    <Credentials />
    <ServicesTeaser />
    <SelloTeaser />
    <TeamStrip />
    <ContactTeaser />
  </main>
  <Footer />
</Layout>
