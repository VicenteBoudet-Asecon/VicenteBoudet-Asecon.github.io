---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seal from '../components/Seal.astro';
import { company, getContent } from '../data/content';
import { getLangFromUrl, path } from '../i18n/config';
import { channels } from '../data/channels';

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);
const [before, accent] = c.thanks.title;
---

<Layout title={c.meta.thanksTitle} description={c.meta.thanksDescription} noindex={true}>
  <Header />
  <main id="contenido">
    <section class="border-t border-plum/15 bg-paper-dim/40">
      <div class="wrap grid grid-cols-1 items-center gap-12 pb-24 pt-14 md:pb-32 md:pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          <p class="eyebrow mb-4">{c.thanks.eyebrow}</p>
          <h1 class="text-balance font-display text-4xl font-medium leading-tight text-ink md:text-5xl">
            {before}
            <span class="italic text-plum">{accent}</span>.
          </h1>
          <p class="mt-6 max-w-[48ch] text-ink/70">{c.thanks.body}</p>

          <dl class="mt-10 space-y-4 border-t border-plum/15 pt-8 font-mono text-sm text-ink/75">
            <div class="flex flex-col gap-1">
              <dt class="text-xs uppercase tracking-[0.1em] text-ink/70">{c.thanks.urgentLabel}</dt>
              <dd>
                <a href={`tel:${company.phone1.replace(/\s/g, '')}`} class="hover:text-plum">{company.phone1}</a>
                <span class="text-ink/70"> &middot; </span>
                <a href={`mailto:${company.email}`} class="hover:text-plum">{company.email}</a>
              </dd>
            </div>
          </dl>

          {/*
            Solo se emite si el archivo real existe (channels.leadMagnet.ready):
            nunca un enlace a un PDF que no está. Empieza oculto con el
            atributo `hidden` nativo; un script de ~5 líneas lo revela cuando
            se llega con ?src=magnet (el envío del formulario de la guía).
          */}
          {channels.leadMagnet.ready && (
            <div
              id="download-guide"
              hidden
              class="mt-8 rounded-lg border border-brass-dark/30 bg-brass/10 p-5"
            >
              <p class="font-display text-lg text-ink">{c.thanks.downloadTitle}</p>
              <p class="mt-1 text-sm text-ink/70">{c.thanks.downloadBody}</p>
              <a href={channels.leadMagnet.href} class="btn-stamp-fill mt-4" data-cta="lead-magnet-download" data-cta-location="thanks">
                {c.leadMagnet.fileLabel}
              </a>
            </div>
          )}

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a href={path('home', lang)} class="btn-stamp-fill">{c.ui.backHome}</a>
            <a href={path('services', lang)} class="btn-stamp">{c.ui.viewServices}</a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <Seal size={240} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

{channels.leadMagnet.ready && (
  <script>
    const params = new URLSearchParams(location.search);
    if (params.get('src') === 'magnet') {
      const block = document.getElementById('download-guide');
      if (block) block.hidden = false;
    }
  </script>
)}

<script>
  // Camino con JS: leadForm.js ya disparó generate_lead (y marcó
  // asecon-lead-fired) antes de traernos hasta acá. Camino sin JS: nadie lo
  // disparó, así que lo hacemos acá — la guarda evita contarlo dos veces si
  // sí hubo JS.
  (function () {
    const params = new URLSearchParams(location.search);
    const src = params.get('src');
    let yaDisparado = false;
    try {
      yaDisparado = sessionStorage.getItem('asecon-lead-fired') === '1';
    } catch (e) {}

    if (!yaDisparado) {
      document.dispatchEvent(
        new CustomEvent('asecon:lead', { detail: { state: 'ok', variant: 'no-js', source: src || 'contact-full' } })
      );
    }
  })();
</script>
