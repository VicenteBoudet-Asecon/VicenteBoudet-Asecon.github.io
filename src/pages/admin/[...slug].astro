---
// El panel completo solo se genera cuando PUBLIC_ENABLE_ADMIN=true en el
// build (uso local/demo). Con getStaticPaths() devolviendo [] en cualquier
// otro build, Astro no emite ningún archivo para esta ruta: /admin no existe
// en absoluto en dist/, ni como HTML ni como referencia.
//
// Esta es la única protección real posible en salida estática: lo que llega
// a publicarse es público, así que la cortina de contraseña que tenía antes
// este panel (AdminGate.astro, un hash SHA-256 comparado en el navegador) no
// protegía nada — comunicaba una seguridad que no existía. Se retiró.
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  if (import.meta.env.PUBLIC_ENABLE_ADMIN !== 'true') return [];
  return [{ params: { slug: undefined } }];
}
---

<Layout
  title="Panel de Analytics — Asecon"
  description="Panel interno de analítica del sitio Asecon."
  noindex={true}
>
  <main id="admin-dashboard" class="min-h-screen bg-paper pb-16">
    <header class="border-b border-plum/15 bg-white">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 py-5">
        <div>
          <p class="eyebrow">Asecon · uso interno</p>
          <h1 class="font-display text-2xl text-ink">Panel de Analytics</h1>
        </div>
        <div class="flex items-center gap-5">
          <a href="/cms/" class="font-mono text-xs uppercase tracking-[0.18em] text-plum hover:text-plum-deep">
            Agregar novedades →
          </a>
          <a href="/" class="font-mono text-xs uppercase tracking-[0.18em] text-plum hover:text-plum-deep">
            ← Volver al sitio público
          </a>
        </div>
      </div>
    </header>

    <div class="wrap mt-6">
      <div class="rounded-xl border border-brass/40 bg-brass/10 px-4 py-3 text-sm text-ink-soft">
        <strong class="text-ink">Vista de demostración, solo local.</strong> Todos los números y envíos de este
        panel son datos de ejemplo generados en el navegador — no hay analítica real conectada todavía. Este
        build no se publica salvo que <code>PUBLIC_ENABLE_ADMIN=true</code> esté definida a propósito para él.
      </div>
    </div>

    <div class="wrap mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex gap-2" role="group" aria-label="Rango de fechas">
        <button type="button" data-range-days="7" class="rounded-full px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors">
          7 días
        </button>
        <button type="button" data-range-days="30" class="rounded-full px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors">
          30 días
        </button>
        <button type="button" data-range-days="90" class="rounded-full px-4 py-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors">
          90 días
        </button>
      </div>
      <p id="admin-updated-at" class="font-mono text-xs text-ink-soft"></p>
    </div>

    <section class="wrap mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6" id="admin-stat-tiles" aria-label="Métricas principales"></section>

    <section class="wrap mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
      <div class="rounded-2xl border border-plum/15 bg-white p-5 lg:col-span-2">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-display text-lg text-ink">Visitas en el tiempo</h2>
          <button type="button" id="admin-visits-table-toggle" class="font-mono text-xs uppercase tracking-[0.14em] text-plum hover:text-plum-deep">
            Ver como tabla
          </button>
        </div>
        <div id="admin-chart-visits"></div>
        <div id="admin-chart-visits-table" class="hidden max-h-64 overflow-auto"></div>
      </div>
      <div class="rounded-2xl border border-plum/15 bg-white p-5">
        <h2 class="mb-3 font-display text-lg text-ink">Fuentes de tráfico</h2>
        <div id="admin-chart-traffic"></div>
      </div>
    </section>

    <section class="wrap mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
      <div class="rounded-2xl border border-plum/15 bg-white p-5">
        <h2 class="mb-3 font-display text-lg text-ink">Páginas más vistas</h2>
        <div id="admin-list-top-pages"></div>
      </div>
      <div class="rounded-2xl border border-plum/15 bg-white p-5">
        <h2 class="mb-3 font-display text-lg text-ink">Dispositivo</h2>
        <div id="admin-chart-devices"></div>
      </div>
      <div class="rounded-2xl border border-plum/15 bg-white p-5">
        <h2 class="mb-3 font-display text-lg text-ink">Embudo de conversión</h2>
        <div id="admin-funnel"></div>
      </div>
    </section>

    <section class="wrap mt-6">
      <div class="rounded-2xl border border-plum/15 bg-white p-5">
        <h2 class="mb-3 font-display text-lg text-ink">Últimos formularios enviados</h2>
        <div id="admin-table-leads" class="overflow-x-auto"></div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { mountAdminDashboard } from '../../scripts/adminDashboard.js';
  mountAdminDashboard();
</script>
