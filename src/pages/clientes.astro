---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Clients from '../components/Clients.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.clientsTitle}
  description={c.meta.clientsDescription}
>
  <Header />
  <main id="contenido">
    <Clients bordered={false} />
    <Testimonials />
    <CtaBanner variant="clients" />
  </main>
  <Footer />
</Layout>
