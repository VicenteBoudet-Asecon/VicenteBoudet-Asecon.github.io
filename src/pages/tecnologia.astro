---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Technology from '../components/Technology.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../data/content';
import { getLangFromUrl } from '../i18n/config';

const c = getContent(getLangFromUrl(Astro.url));
---

<Layout
  title={c.meta.technologyTitle}
  description={c.meta.technologyDescription}
  noindex={true}
>
  <Header />
  <main id="contenido">
    <Technology bordered={false} />
    <CtaBanner variant="technology" />
  </main>
  <Footer />
</Layout>
