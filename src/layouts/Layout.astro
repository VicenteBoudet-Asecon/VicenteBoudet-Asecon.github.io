---
import '../styles/global.css';
import { company, getContent } from '../data/content';
import { getLangFromUrl, languages, routes, keyFromPath, defaultLang } from '../i18n/config';
import StickyCta from '../components/StickyCta.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { organizationSchema, websiteSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** false en /admin: un CTA de venta sobre un panel interno no tiene sentido. */
  stickyCta?: boolean;
  /** Solo la home: adelanta la descarga del poster del hero (el LCP real de esa página). */
  preloadImage?: string;
  /**
   * Solo para /novedades/[slug] y /en/insights/[slug]: keyFromPath() no
   * reconoce esas rutas (no viven en el mapa de `routes`), así que sin esto
   * la nota se publica sin hreflang. El resto de las páginas lo calculan
   * solas desde `routes`.
   */
  alternates?: Array<{ code: string; hreflang: string; href: string }>;
  /**
   * El tramo de BreadcrumbList después de "Inicio", sin incluirlo. Por
   * defecto se arma solo desde el nombre de menú de la página; hace falta
   * pasarlo a mano en páginas de dos niveles (una nota dentro de Novedades).
   */
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const lang = getLangFromUrl(Astro.url);
const c = getContent(lang);

const {
  title = c.meta.homeTitle,
  description = c.meta.homeDescription,
  image = '/og-image.png',
  noindex = false,
  stickyCta = true,
  preloadImage,
  alternates: alternatesProp,
  breadcrumbs,
} = Astro.props;

// Cloudflare Turnstile (antispam del formulario, ver LeadForm.astro): el
// loader va una sola vez acá aunque haya varios LeadForm en la página. Sin
// PUBLIC_TURNSTILE_SITEKEY no se carga ningún script de tercero.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';

const site = Astro.site ?? new URL('https://aseconsa.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// La misma barra final que ya usa el canonical: sin esto, Google ve
// hreflang="/contacto" (sin barra) junto a un canonical "/contacto/" (con
// barra) en la misma página — dos formas de la misma URL, una señal de
// duplicado que no hace falta emitir.
const conBarra = (ruta: string) => (ruta === '/' ? '/' : `${ruta}/`);

// Alternativas de idioma: le dicen a Google que estas dos URLs son la misma
// página en distintos idiomas, en vez de contenido duplicado. Para
// /novedades/[slug] y /en/insights/[slug], que no viven en `routes`, la
// página las pasa calculadas a mano (ver alternatesProp más arriba).
const pageKey = keyFromPath(Astro.url.pathname);
const autoAlternates = pageKey
  ? Object.entries(routes[pageKey]).map(([code, href]) => ({
      code,
      hreflang: languages[code].htmlLang,
      href: new URL(conBarra(href), site).href,
    }))
  : [];
const alternates = alternatesProp ?? autoAlternates;

// La organización (+ WebSite) se emite una sola vez, en la home: es una
// entidad, no algo que tenga sentido repetir con una descripción distinta
// en cada una de las 26 páginas. El resto emite WebPage + BreadcrumbList
// referenciando esa misma entidad por @id.
const esHome = pageKey === 'home';
const jsonLdBlocks = esHome
  ? [
      organizationSchema({
        site,
        company,
        lang,
        description: c.meta.homeDescription,
        ogImage: new URL('/og-image.png', site).href,
        serviceList: c.serviceList,
        geo: company.geoLat && company.geoLng ? { latitude: company.geoLat, longitude: company.geoLng } : undefined,
      }),
      websiteSchema({ site, company, lang }),
    ]
  : [
      webPageSchema({ site, canonical, title, description }),
      breadcrumbSchema({
        site,
        homeName: c.nav.home,
        homePath: routes.home[lang],
        trail: breadcrumbs ?? (pageKey && c.nav[pageKey] ? [{ name: c.nav[pageKey], path: Astro.url.pathname }] : []),
      }),
    ];
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6B1F7E" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {alternates.length > 0 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={alternates.find((a) => a.code === defaultLang)?.href}
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* La vía preferida es un TXT en el DNS (sobrevive a cambios de
        hosting); esta variable es el respaldo. Sin ella no se emite nada. */}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    {/* Fraunces e IBM Plex Mono ahora se autoalojan (ver src/styles/global.css):
        sin fonts.googleapis.com ni fonts.gstatic.com, dos terceros menos en
        cada una de las 26 páginas. */}

    {/* Solo cuando la página lo pide (la home, con su poster de Hero.astro):
        es el candidato a LCP real de esa página, y el navegador no tiene
        forma de adelantarlo solo — está detrás de un atributo `poster` de
        <video>, no de un <img> normal. */}
    {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${company.name} — ${c.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
    {turnstileKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    )}
    <Analytics />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-plum focus:px-5 focus:py-3 focus:font-mono focus:text-xs focus:uppercase focus:tracking-[0.18em] focus:text-paper"
    >
      {c.ui.skipToContent}
    </a>
    <slot />
    {stickyCta && <StickyCta />}
    <ConsentBanner />
    <script>
      import '../scripts/tracking.js';
    </script>
  </body>
</html>
